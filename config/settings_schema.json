[
  {
    "name": "theme_info",
    "theme_name": "KOVA",
    "theme_version": "0.2.0",
    "theme_author": "KOVA",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_display_font",
        "default": "oswald_n7",
        "label": "t:general.display"
      },
      {
        "type": "font_picker",
        "id": "type_mono_font",
        "default": "ibm_plex_mono_n4",
        "label": "t:general.mono"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "inter_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "110rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 28
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#000000",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#F4F4F4",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "dark_color",
        "default": "#000000",
        "label": "t:labels.dark_color",
        "info": "t:info.dark_color"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#E4E4E4",
        "label": "t:labels.accent_color",
        "info": "t:info.accent_color"
      },
      {
        "type": "color",
        "id": "accent_contrast_color",
        "default": "#000000",
        "label": "t:labels.accent_contrast_color",
        "info": "t:info.accent_contrast_color"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 0
      }
    ]
  }
]
