{% liquid
  assign shopping_url = collections['drop-001'].url
  if shopping_url == blank
    assign shopping_url = '/collections/drop-001'
  endif
%}

<section class="not-found full-width section-pad">
  <div class="not-found__inner page-inner">
    <p class="eyebrow">{{ '404.title' | t }}</p>
    <h1 class="display-title">{{ '404.not_found' | t }}</h1>
    <a class="btn btn--arrow" href="{{ shopping_url }}">
      {{ '404.back_to_shopping' | t }}
    </a>
  </div>
</section>

{% stylesheet %}
  .not-found__inner {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    min-height: 50vh;
    align-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
