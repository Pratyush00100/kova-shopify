<section class="about-pillars full-width section-pad">
  <div class="about-pillars__inner page-inner">
    {% if section.settings.heading != blank %}
      <h2 class="eyebrow eyebrow--marked about-pillars__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ol class="about-pillars__list">
        {% for block in section.blocks %}
          <li class="about-pillars__item" {{ block.shopify_attributes }}>
            <div class="about-pillars__media">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'about-pillars__image',
                    widths: '400, 700, 1000, 1200',
                    sizes: '(min-width: 900px) 30vw, 100vw',
                    loading: 'lazy'
                }}
              {% else %}
                <span class="about-pillars__placeholder" aria-hidden="true"></span>
              {% endif %}
            </div>

            <p class="about-pillars__index" aria-hidden="true">
              {{ forloop.index | prepend: '0' | slice: -2, 2 }}
            </p>

            {% if block.settings.title != blank %}
              <h3 class="about-pillars__title">{{ block.settings.title | escape }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p class="about-pillars__text">{{ block.settings.text | escape }}</p>
            {% endif %}
          </li>
        {% endfor %}
      </ol>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .about-pillars {
    border-top: 1px solid var(--color-border);
    content-visibility: auto;
    contain-intrinsic-size: auto 36rem;
  }

  .about-pillars__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .about-pillars__heading {
    margin: 0;
  }

  .about-pillars__list {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-pillars__item {
    display: grid;
    align-content: start;
    gap: 0.85rem;
  }

  .about-pillars__media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-surface);
  }

  .about-pillars__image,
  .about-pillars__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-pillars__placeholder {
    background:
      repeating-linear-gradient(
        -18deg,
        var(--color-surface-strong) 0 1px,
        transparent 1px 18px
      );
  }

  .about-pillars__index {
    margin: 0;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
  }

  .about-pillars__title {
    margin: 0;
    font-family: var(--font-display--family);
    font-style: var(--font-display--style);
    font-weight: var(--font-display--weight);
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .about-pillars__text {
    margin: 0;
    max-width: 28ch;
    color: var(--color-foreground-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  @media (min-width: 750px) {
    .about-pillars__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
    }

    .about-pillars__item {
      padding-inline: clamp(1rem, 2vw, 1.75rem);
      border-right: 1px solid var(--color-border);
    }

    .about-pillars__item:first-child {
      padding-inline-start: 0;
    }

    .about-pillars__item:last-child {
      padding-inline-end: 0;
      border-right: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.about_pillars",
  "tag": "div",
  "class": "section-about-pillars",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "t:general.about_pillar",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:info.image_placeholder"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.about_pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "title": "BUILT FROM METAL",
            "text": "Premium stainless steel. Precision cut. Made to last."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "DESIGNED TO STAND OUT",
            "text": "Clean silhouettes. Bold shadows. Timeless design."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "MADE FOR YOUR SPACE",
            "text": "More than decor. A reflection of what you love."
          }
        }
      ]
    }
  ]
}
{% endschema %}
