<section class="about-statement full-width">
  <div class="about-statement__inner page-inner">
    <div class="about-statement__copy">
      {% if section.settings.heading != blank %}
        <h2 class="display-title about-statement__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.outline_heading != blank %}
        <p class="about-statement__outline">{{ section.settings.outline_heading | escape }}</p>
      {% endif %}
    </div>

    <figure class="about-statement__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            class: 'about-statement__image',
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 900px) 48vw, 100vw',
            loading: 'lazy'
        }}
      {% else %}
        <span class="about-statement__placeholder" aria-hidden="true"></span>
      {% endif %}

      {% if section.settings.caption != blank %}
        <figcaption class="about-statement__caption">{{ section.settings.caption | escape }}</figcaption>
      {% endif %}
    </figure>
  </div>
</section>

{% stylesheet %}
  .about-statement {
    border-top: 1px solid var(--color-border);
    content-visibility: auto;
    contain-intrinsic-size: auto 40rem;
  }

  .about-statement__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: var(--space-section);
  }

  .about-statement__copy {
    display: grid;
    align-content: center;
    gap: 0.85rem;
    max-width: 14ch;
  }

  .about-statement__heading,
  .about-statement__outline {
    margin: 0;
    font-family: var(--font-display--family);
    font-style: var(--font-display--style);
    font-weight: var(--font-display--weight);
    font-size: var(--display-md);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .about-statement__outline {
    color: var(--color-foreground-muted);
  }

  @supports (-webkit-text-stroke: 1px currentColor) {
    .about-statement__outline {
      color: transparent;
      -webkit-text-fill-color: transparent;
      -webkit-text-stroke: 1.5px var(--color-foreground);
    }
  }

  .about-statement__media {
    position: relative;
    margin: 0;
    overflow: hidden;
    min-height: 22rem;
    aspect-ratio: 4 / 5;
    background: var(--color-surface);
  }

  .about-statement__image,
  .about-statement__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-statement__placeholder {
    background:
      repeating-linear-gradient(
        -18deg,
        var(--color-surface-strong) 0 1px,
        transparent 1px 18px
      );
  }

  .about-statement__caption {
    position: absolute;
    right: var(--page-margin);
    bottom: 1.25rem;
    margin: 0;
    color: var(--color-inverse-foreground);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    mix-blend-mode: difference;
  }

  @media (min-width: 900px) {
    .about-statement__inner {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      min-height: min(78vh, 44rem);
    }

    .about-statement__media {
      min-height: 100%;
      aspect-ratio: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.about_statement",
  "tag": "div",
  "class": "section-about-statement",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "WE DON'T MAKE WALL DECOR."
    },
    {
      "type": "text",
      "id": "outline_heading",
      "label": "t:labels.outline_heading",
      "default": "WE MAKE STATEMENTS FOR EMPTY WALLS."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.image_placeholder"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:labels.caption",
      "default": "OBSESSION IN EVERY DETAIL."
    }
  ],
  "presets": [
    {
      "name": "t:general.about_statement"
    }
  ]
}
{% endschema %}
