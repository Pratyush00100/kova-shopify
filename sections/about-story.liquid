<section class="about-story full-width">
  <div class="about-story__inner">
    <div class="about-story__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            class: 'about-story__image',
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 900px) 48vw, 100vw',
            loading: 'lazy'
        }}
      {% else %}
        <span class="about-story__placeholder" aria-hidden="true"></span>
      {% endif %}

      {% if section.settings.media_caption != blank %}
        <p class="about-story__media-caption">{{ section.settings.media_caption | escape }}</p>
      {% endif %}
    </div>

    <div class="about-story__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="about-story__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="about-story__body">{{ section.settings.description }}</div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          class="btn btn--arrow"
          href="{{ section.settings.button_link | default: '/pages/about' }}"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}

      {% if section.settings.overlay_image != blank %}
        <div class="about-story__overlay">
          {{
            section.settings.overlay_image
            | image_url: width: 480
            | image_tag:
              class: 'about-story__overlay-image',
              widths: '200, 320, 480',
              sizes: '(min-width: 900px) 18vw, 40vw',
              loading: 'lazy',
              alt: ''
          }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .about-story {
    border-top: 1px solid var(--color-border);
  }

  .about-story__inner {
    display: grid;
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .about-story__media,
  .about-story__copy {
    min-height: 18rem;
  }

  .about-story__media {
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
  }

  .about-story__image,
  .about-story__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-story__placeholder {
    min-height: 22rem;
    background:
      repeating-linear-gradient(
        -18deg,
        var(--color-surface-strong) 0 1px,
        transparent 1px 18px
      );
  }

  .about-story__media-caption {
    position: absolute;
    left: var(--page-margin);
    bottom: 1.5rem;
    z-index: 1;
    margin: 0;
    max-width: 10ch;
    font-family: var(--font-display--family);
    font-style: var(--font-display--style);
    font-weight: var(--font-display--weight);
    font-size: clamp(1.5rem, 3.2vw, 2.4rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .about-story__copy {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.15rem;
    padding: clamp(2.5rem, 7vw, 5rem) var(--page-margin);
    overflow: hidden;
  }

  .about-story__heading {
    margin: 0;
    max-width: 12ch;
    font-family: var(--font-display--family);
    font-style: var(--font-display--style);
    font-weight: var(--font-display--weight);
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .about-story__body {
    max-width: 42ch;
    color: var(--color-foreground-muted);
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .about-story__body p {
    margin: 0;
  }

  .about-story__overlay {
    position: absolute;
    right: var(--page-margin);
    bottom: 1.5rem;
    width: min(11rem, 38%);
    opacity: 0.45;
    pointer-events: none;
  }

  .about-story__overlay-image {
    width: 100%;
    height: auto;
  }

  @media (min-width: 900px) {
    .about-story__inner {
      grid-template-columns: 1fr 1fr;
      min-height: min(72vh, 40rem);
    }

    .about-story__media,
    .about-story__placeholder {
      min-height: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.about_story",
  "tag": "div",
  "class": "section-about-story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "ABOUT KOVA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "BUILT DIFFERENT. MADE FOR YOU."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "OUR STORY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "text",
      "id": "media_caption",
      "label": "t:labels.media_caption"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.image_placeholder"
    },
    {
      "type": "image_picker",
      "id": "overlay_image",
      "label": "t:labels.overlay_image",
      "info": "t:info.overlay_image"
    }
  ],
  "presets": [
    {
      "name": "t:general.about_story"
    }
  ]
}
{% endschema %}
