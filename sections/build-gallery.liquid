{% liquid
  assign slide_count = 0
  for block in section.blocks
    if block.type == 'photo'
      if block.settings.image != blank
        assign slide_count = slide_count | plus: 1
      endif
    elsif block.type == 'youtube'
      if block.settings.video_url != blank
        assign slide_count = slide_count | plus: 1
      endif
    endif
  endfor

  assign gallery_label = section.settings.heading
  if gallery_label == blank
    assign gallery_label = section.settings.eyebrow
  endif
  if gallery_label == blank
    assign gallery_label = 'accessibility.gallery' | t
  endif
%}

{% if slide_count > 0 %}
  <section
    class="build-gallery full-width section-pad"
    data-build-gallery
    aria-roledescription="{{ 'accessibility.carousel' | t }}"
    aria-label="{{ gallery_label | escape }}"
  >
    <div class="build-gallery__inner page-inner">
      {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
        <header class="build-gallery__header">
          {% if section.settings.eyebrow != blank %}
            <p class="eyebrow eyebrow--marked">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
          {% endif %}
        </header>
      {% endif %}

      <div class="build-gallery__stage">
        {% if slide_count > 1 %}
          <button
            class="build-gallery__control"
            type="button"
            data-gallery-prev
            aria-label="{{ 'accessibility.previous_slide' | t }}"
          >
            <span aria-hidden="true">←</span>
          </button>
        {% endif %}

        <ul class="build-gallery__track" role="list">
          {% assign slide_index = 0 %}
          {% for block in section.blocks %}
            {% liquid
              assign youtube_id = blank
              assign video_url = block.settings.video_url
              assign show_slide = false

              if block.type == 'photo' and block.settings.image != blank
                assign show_slide = true
              endif

              if block.type == 'youtube' and video_url != blank
                if video_url contains 'youtu.be/'
                  assign youtube_id = video_url | split: 'youtu.be/' | last | split: '?' | first | split: '/' | first
                elsif video_url contains '/embed/'
                  assign youtube_id = video_url | split: 'embed/' | last | split: '?' | first | split: '/' | first
                elsif video_url contains '/shorts/'
                  assign youtube_id = video_url | split: 'shorts/' | last | split: '?' | first | split: '/' | first
                elsif video_url contains 'v='
                  assign youtube_id = video_url | split: 'v=' | last | split: '&' | first
                endif

                if youtube_id != blank
                  assign show_slide = true
                endif
              endif
            %}

            {% if show_slide %}
              {% assign slide_index = slide_index | plus: 1 %}
              <li
                class="build-gallery__slide"
                id="Gallery-{{ section.id }}-{{ slide_index }}"
                {{ block.shopify_attributes }}
              >
                {% if block.type == 'photo' %}
                  {{
                    block.settings.image
                    | image_url: width: 1800
                    | image_tag:
                      class: 'build-gallery__image',
                      widths: '600, 900, 1200, 1600, 1800',
                      sizes: '(min-width: 900px) 72vw, 100vw',
                      loading: 'lazy',
                      alt: block.settings.image.alt | default: block.settings.alt
                  }}
                {% else %}
                  <div
                    class="build-gallery__video"
                    data-youtube-id="{{ youtube_id | escape }}"
                    {% if block.settings.alt != blank %}
                      data-video-title="{{ block.settings.alt | escape }}"
                    {% else %}
                      data-video-title="{{ 'accessibility.play_video' | t | escape }}"
                    {% endif %}
                  >
                    {% # theme-check-disable RemoteAsset %}
                    <img
                      class="build-gallery__poster"
                      src="https://i.ytimg.com/vi/{{ youtube_id | escape }}/hqdefault.jpg"
                      alt="{{ block.settings.alt | escape }}"
                      width="1280"
                      height="720"
                      loading="lazy"
                    >
                    {% # theme-check-enable RemoteAsset %}
                    <button class="build-gallery__play" type="button">
                      <span class="build-gallery__play-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">{{ 'accessibility.play_video' | t }}</span>
                    </button>
                  </div>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>

        {% if slide_count > 1 %}
          <button
            class="build-gallery__control"
            type="button"
            data-gallery-next
            aria-label="{{ 'accessibility.next_slide' | t }}"
          >
            <span aria-hidden="true">→</span>
          </button>
        {% endif %}
      </div>

      {% if slide_count > 1 %}
        <p
          class="build-gallery__status"
          data-gallery-status
          data-status-template="{{ 'accessibility.slide_of' | t: current: '[[n]]', total: slide_count | escape }}"
          aria-live="polite"
        >
          {{ 'accessibility.slide_of' | t: current: 1, total: slide_count }}
        </p>
      {% endif %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .build-gallery__inner {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .build-gallery__header {
    display: grid;
    gap: 0.6rem;
  }

  .build-gallery__stage {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.75rem;
    align-items: center;
  }

  .build-gallery__track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    background: var(--color-inverse);
  }

  .build-gallery__track::-webkit-scrollbar {
    display: none;
  }

  .build-gallery__slide {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
    container-type: scroll-state;
  }

  .build-gallery__image,
  .build-gallery__poster,
  .build-gallery__video iframe {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-inverse);
  }

  .build-gallery__video {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-inverse);
  }

  .build-gallery__video iframe {
    position: absolute;
    inset: 0;
    border: 0;
  }

  .build-gallery__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 0;
    background: rgb(0 0 0 / 28%);
    cursor: pointer;
  }

  .build-gallery__play-icon {
    width: 0;
    height: 0;
    margin-left: 0.2rem;
    border-style: solid;
    border-width: 0.65rem 0 0.65rem 1.1rem;
    border-color: transparent transparent transparent currentcolor;
  }

  .build-gallery__control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-mono--family);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .build-gallery__control:hover,
  .build-gallery__control:focus-visible {
    border-color: var(--color-foreground);
  }

  .build-gallery__status {
    margin: 0;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  @media (max-width: 749px) {
    .build-gallery__stage {
      grid-template-columns: 1fr;
    }

    .build-gallery__control {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .build-gallery__track {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    const galleries = document.querySelectorAll('[data-build-gallery]');
    if (!galleries.length) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hasSnapEvents = 'onscrollsnapchanging' in Element.prototype;

    galleries.forEach(function (root) {
      const track = root.querySelector('.build-gallery__track');
      const slides = track ? Array.from(track.querySelectorAll('.build-gallery__slide')) : [];
      const status = root.querySelector('[data-gallery-status]');
      const prev = root.querySelector('[data-gallery-prev]');
      const next = root.querySelector('[data-gallery-next]');
      if (!track || slides.length === 0) return;

      let activeIndex = 0;
      const statusTemplate = status ? status.getAttribute('data-status-template') || '' : '';

      function unloadVideos(exceptIndex) {
        slides.forEach(function (slide, index) {
          if (index === exceptIndex) return;
          const holder = slide.querySelector('[data-youtube-id]');
          if (!holder) return;
          const frame = holder.querySelector('iframe');
          if (!frame) return;
          const poster = holder.querySelector('.build-gallery__poster');
          const play = holder.querySelector('.build-gallery__play');
          frame.remove();
          if (poster) poster.hidden = false;
          if (play) play.hidden = false;
        });
      }

      function setActive(index) {
        if (index < 0 || index >= slides.length) return;
        activeIndex = index;
        unloadVideos(index);
        if (status && statusTemplate) {
          status.textContent = statusTemplate.replace('[[n]]', String(index + 1));
        }
      }

      function closestIndex() {
        const center = track.scrollLeft + track.clientWidth / 2;
        let closest = 0;
        let min = Infinity;
        slides.forEach(function (slide, index) {
          const slideCenter = slide.offsetLeft + slide.offsetWidth / 2;
          const distance = Math.abs(center - slideCenter);
          if (distance < min) {
            min = distance;
            closest = index;
          }
        });
        return closest;
      }

      function goTo(index) {
        const nextIndex = Math.max(0, Math.min(slides.length - 1, index));
        slides[nextIndex].scrollIntoView({
          behavior: reduceMotion ? 'auto' : 'smooth',
          inline: 'start',
          block: 'nearest'
        });
        setActive(nextIndex);
      }

      if (prev) {
        prev.addEventListener('click', function () {
          goTo(activeIndex - 1);
        });
      }

      if (next) {
        next.addEventListener('click', function () {
          goTo(activeIndex + 1);
        });
      }

      if (hasSnapEvents) {
        track.addEventListener('scrollsnapchange', function (event) {
          const snapped = event.snapTargetInline;
          const index = slides.indexOf(snapped);
          if (index !== -1) setActive(index);
        });
      } else {
        let rafId = null;
        track.addEventListener(
          'scroll',
          function () {
            if (rafId) return;
            rafId = requestAnimationFrame(function () {
              rafId = null;
              setActive(closestIndex());
            });
          },
          { passive: true }
        );
      }

      root.querySelectorAll('[data-youtube-id]').forEach(function (holder) {
        const play = holder.querySelector('.build-gallery__play');
        if (!play) return;

        play.addEventListener('click', function () {
          const id = holder.getAttribute('data-youtube-id');
          const title = holder.getAttribute('data-video-title') || '';
          if (!id || holder.querySelector('iframe')) return;

          const iframe = document.createElement('iframe');
          iframe.src =
            'https://www.youtube-nocookie.com/embed/' +
            encodeURIComponent(id) +
            '?autoplay=1&rel=0';
          iframe.title = title;
          iframe.allow =
            'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen';
          iframe.allowFullscreen = true;
          const poster = holder.querySelector('.build-gallery__poster');
          if (poster) poster.hidden = true;
          play.hidden = true;
          holder.appendChild(iframe);
        });
      });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.build_gallery",
  "tag": "div",
  "class": "section-build-gallery",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "t:general.photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:info.assigned_image_only"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "t:labels.accessibility_label"
        }
      ]
    },
    {
      "type": "youtube",
      "name": "t:general.youtube",
      "settings": [
        {
          "type": "video_url",
          "id": "video_url",
          "label": "t:labels.youtube_url",
          "accept": ["youtube"],
          "info": "t:info.youtube_url"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "t:labels.accessibility_label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.build_gallery",
      "blocks": [
        { "type": "photo" },
        { "type": "youtube" }
      ]
    }
  ]
}
{% endschema %}
