{% comment %}
  This section is used in the cart template to render the /cart page with an
  overview of the items in the customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

{% liquid
  assign cart_heading = section.settings.heading
  if cart_heading == blank
    assign cart_heading = 'cart.title' | t
  endif
%}

<div class="cart full-width section-pad">
  <div class="cart__inner page-inner">
    <header class="cart__header">
      <h1 class="display-title">{{ cart_heading | escape }}</h1>
      <p class="cart__count">{{ 'cart.item_count' | t: count: cart.item_count }}</p>
    </header>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <ul class="cart__items" role="list">
          {% for item in cart.items %}
            <li class="cart__item">
              <a class="cart__media" href="{{ item.url }}">
                {% if item.image %}
                  {{
                    item.image
                    | image_url: width: 400
                    | image_tag:
                      class: 'cart__image',
                      widths: '150, 250, 400',
                      sizes: '120px',
                      loading: 'lazy',
                      alt: item.title
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'media-placeholder' }}
                {% endif %}
              </a>

              <div class="cart__item-info">
                <a class="cart__item-title" href="{{ item.url }}">{{ item.product.title | escape }}</a>

                {% unless item.variant.title contains 'Default' %}
                  <p class="cart__item-variant">{{ item.variant.title | escape }}</p>
                {% endunless %}

                <p class="cart__item-price">{{ item.final_price | money }}</p>
              </div>

              <div class="cart__item-actions">
                <label class="visually-hidden" for="CartQuantity-{{ forloop.index }}">
                  {{ 'cart.quantity' | t }}
                </label>

                <input
                  id="CartQuantity-{{ forloop.index }}"
                  class="cart__quantity"
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  step="1"
                >

                <a class="cart__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
              </div>

              <p class="cart__item-total">{{ item.final_line_price | money }}</p>
            </li>
          {% endfor %}
        </ul>

        <div class="cart__footer">
          <div class="cart__totals">
            <div class="cart__total-row">
              <span>{{ 'cart.subtotal' | t }}</span>
              <span class="cart__subtotal">{{ cart.total_price | money }}</span>
            </div>

            <p class="cart__note">{{ 'cart.taxes_note' | t }}</p>
          </div>

          <div class="cart__actions">
            <button class="btn btn--ghost" type="submit" name="update">
              {{ 'cart.update' | t }}
            </button>

            <button class="btn" type="submit" name="checkout">
              {{ 'cart.checkout' | t }}
            </button>
          </div>
        </div>
      </form>
    {% else %}
      <div class="cart__empty">
        <p class="section-title">{{ 'cart.empty' | t }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">
          {{ 'cart.continue_shopping' | t }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .cart__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .cart__header {
    display: grid;
    gap: 0.75rem;
  }

  .cart__count {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cart__items {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .cart__item {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem 1.25rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cart__media {
    display: block;
    width: 5.5rem;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .cart__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart__item-info {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .cart__item-title {
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cart__item-variant,
  .cart__item-price {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }

  .cart__item-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    grid-column: 2;
  }

  .cart__quantity {
    width: 4.5rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .cart__remove {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .cart__item-total {
    margin: 0;
    grid-column: 2;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }

  .cart__footer {
    display: grid;
    gap: 1.5rem;
  }

  .cart__total-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cart__note {
    margin: 0.75rem 0 0;
    color: var(--color-foreground-muted);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .cart__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cart__empty {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    padding-block: clamp(2rem, 6vw, 4rem);
  }

  @media (min-width: 750px) {
    .cart__item {
      grid-template-columns: 5.5rem minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 1.5rem;
    }

    .cart__item-actions,
    .cart__item-total {
      grid-column: auto;
    }

    .cart__item-total {
      min-width: 6rem;
      text-align: right;
    }

    .cart__footer {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .cart__totals {
      max-width: 22rem;
    }

    .cart__actions {
      justify-content: flex-end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "CART"
    }
  ]
}
{% endschema %}
