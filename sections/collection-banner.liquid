{% comment %}
  Editorial banner for collection pages. Content comes from the collection
  itself, with optional theme editor overrides for drop-specific framing.
{% endcomment %}

{% liquid
  assign banner_heading = section.settings.heading
  if banner_heading == blank
    assign banner_heading = collection.title
  endif

  assign banner_image = section.settings.image
  if banner_image == blank
    assign banner_image = collection.image
  endif
%}

<section class="collection-banner full-width">
  {% if section.settings.show_image %}
    <div class="collection-banner__media" aria-hidden="true">
      {% if banner_image != blank %}
        {{
          banner_image
          | image_url: width: 2400
          | image_tag:
            class: 'collection-banner__image',
            widths: '750, 1100, 1500, 1800, 2400',
            sizes: '100vw',
            loading: 'eager'
        }}
      {% else %}
        {{ 'collection-1' | placeholder_svg_tag: 'media-placeholder collection-banner__placeholder' }}
      {% endif %}
      <div class="collection-banner__scrim"></div>
    </div>
  {% endif %}

  <div class="collection-banner__inner page-inner{% if section.settings.show_image %} collection-banner__inner--over-media{% endif %}">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow collection-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    <h1 class="display-title">{{ banner_heading | escape }}</h1>

    {% if section.settings.description != blank %}
      <div class="rte collection-banner__description">{{ section.settings.description }}</div>
    {% elsif collection.description != blank %}
      <div class="rte collection-banner__description">{{ collection.description }}</div>
    {% endif %}

    <p class="collection-banner__count">
      {{ 'collections.product_count' | t: count: collection.products_count }}
    </p>
  </div>
</section>

{% stylesheet %}
  .collection-banner {
    position: relative;
    display: grid;
    isolation: isolate;
    border-bottom: 1px solid var(--color-border);
  }

  .collection-banner__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .collection-banner__image,
  .collection-banner__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-banner__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgb(0 0 0 / 76%) 10%, rgb(0 0 0 / 40%) 100%);
  }

  .collection-banner__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    padding-block: clamp(3.5rem, 10vw, 7rem);
  }

  .collection-banner__inner--over-media {
    min-height: clamp(20rem, 45vw, 32rem);
    align-content: end;
    color: var(--color-background);
  }

  .collection-banner__inner--over-media .collection-banner__eyebrow,
  .collection-banner__inner--over-media .collection-banner__description,
  .collection-banner__inner--over-media .collection-banner__count {
    color: color-mix(in srgb, var(--color-background) 72%, transparent);
  }

  .collection-banner__description {
    max-width: 48ch;
  }

  .collection-banner__count {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_banner",
  "tag": "div",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "DROP 001"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.heading_fallback_collection"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description",
      "info": "t:info.description_fallback_collection"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:labels.show_image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.image_fallback_collection"
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_banner"
    }
  ]
}
{% endschema %}
