{% comment %}
  Drop identity for collection pages.

  Heading, description and imagery resolve from Shopify collection data unless a
  theme editor override is set. Optional fields stay hidden when empty instead of
  falling back to placeholder art or invented copy.
{% endcomment %}

{% liquid
  assign banner_heading = section.settings.heading
  if banner_heading == blank
    assign banner_heading = collection.title
  endif

  assign banner_description = section.settings.description
  if banner_description == blank
    assign banner_description = collection.description
  endif

  assign banner_image = section.settings.image
  if banner_image == blank
    assign banner_image = collection.image
  endif

  assign has_media = false
  if section.settings.show_image
    if banner_image != blank
      assign has_media = true
    endif
  endif
%}

<section class="collection-banner full-width{% if has_media %} collection-banner--media{% endif %}">
  {% if has_media %}
    <div class="collection-banner__media" aria-hidden="true">
      {{
        banner_image
        | image_url: width: 2400
        | image_tag:
          class: 'collection-banner__image',
          widths: '750, 1100, 1500, 1800, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high'
      }}
      <div class="collection-banner__scrim"></div>
    </div>
  {% endif %}

  <div class="collection-banner__inner page-inner">
    <div class="collection-banner__meta">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow collection-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if collection.products_count > 0 %}
        <p class="collection-banner__count">
          {{- 'collections.product_count' | t: count: collection.products_count -}}
        </p>
      {% endif %}
    </div>

    <h1 class="display-title collection-banner__heading">{{ banner_heading | escape }}</h1>

    {% if banner_description != blank %}
      <div class="rte collection-banner__description">{{ banner_description }}</div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .collection-banner {
    position: relative;
    display: grid;
    isolation: isolate;
    border-bottom: 1px solid var(--color-border);
  }

  .collection-banner__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .collection-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-banner__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 74%) 0%,
      rgb(0 0 0 / 42%) 52%,
      rgb(0 0 0 / 22%) 100%
    );
  }

  .collection-banner__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(0.85rem, 1.6vw, 1.35rem);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .collection-banner--media .collection-banner__inner {
    min-height: clamp(18rem, 38vw, 27rem);
    align-content: end;
    color: var(--color-background);
  }

  .collection-banner--media .collection-banner__eyebrow,
  .collection-banner--media .collection-banner__count,
  .collection-banner--media .collection-banner__description {
    color: color-mix(in srgb, var(--color-background) 74%, transparent);
  }

  /* Metadata line: drop label and live piece count read as one row. */
  .collection-banner__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }

  .collection-banner__count {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Held below the homepage hero scale so the drop page stays a catalog. */
  .collection-banner__heading {
    font-size: clamp(2.5rem, 6.5vw, 4.5rem);
  }

  .collection-banner__description {
    max-width: 46ch;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_banner",
  "tag": "div",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "DROP 001"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.heading_fallback_collection"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description",
      "info": "t:info.description_fallback_collection"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:labels.show_image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.image_fallback_collection"
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_banner"
    }
  ]
}
{% endschema %}
