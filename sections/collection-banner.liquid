{% comment %}
  Full-bleed collection hero. Image comes from the theme editor, then the
  Shopify collection image. Copy is merchant-editable; products stay in the
  collection grid below.
{% endcomment %}

{% liquid
  assign banner_heading = section.settings.heading
  if banner_heading == blank
    assign banner_heading = collection.title
  endif

  assign banner_description = section.settings.description

  assign banner_image = section.settings.image
  if banner_image == blank
    assign banner_image = collection.image
  endif

  assign has_media = false
  if section.settings.show_image
    if banner_image != blank
      assign has_media = true
    endif
  endif

  assign image_loading = 'eager'
  assign image_fetchpriority = 'high'
  if section.index > 1
    assign image_loading = 'lazy'
    assign image_fetchpriority = 'low'
  endif
%}

<section class="collection-banner full-width{% if has_media %} collection-banner--media{% endif %}">
  <div class="collection-banner__media" {% unless has_media %}aria-hidden="true"{% endunless %}>
    {% if has_media %}
      {{
        banner_image
        | image_url: width: 3200
        | image_tag:
          class: 'collection-banner__image',
          widths: '750, 1100, 1400, 1800, 2400, 3200',
          sizes: '100vw',
          loading: image_loading,
          fetchpriority: image_fetchpriority
      }}
    {% else %}
      <div class="collection-banner__placeholder"></div>
    {% endif %}
  </div>

  <div class="collection-banner__inner">
    <div class="collection-banner__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow collection-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if banner_heading != blank %}
        <h1 class="collection-banner__heading">{{ banner_heading | escape }}</h1>
      {% endif %}

      {% if banner_description != blank %}
        <div class="rte collection-banner__description">{{ banner_description }}</div>
      {% endif %}
    </div>

    {% if section.settings.quote != blank %}
      <blockquote class="collection-banner__quote">
        <span class="collection-banner__quote-frame" aria-hidden="true"></span>
        {{ section.settings.quote | escape | newline_to_br }}
      </blockquote>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .collection-banner {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: calc(100svh - var(--header-height));
    border-bottom: 1px solid var(--color-border);
  }

  @supports (height: 100dvh) {
    .collection-banner {
      min-height: calc(100dvh - var(--header-height));
    }
  }

  .collection-banner__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--color-background);
  }

  .collection-banner--media .collection-banner__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgb(0 0 0 / 62%) 0%,
      rgb(0 0 0 / 28%) 34%,
      rgb(0 0 0 / 8%) 62%,
      rgb(0 0 0 / 0%) 100%
    );
  }

  .collection-banner__image,
  .collection-banner__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .collection-banner__image {
    position: absolute;
    inset: 0;
    object-fit: cover;
    object-position: center;
  }

  .collection-banner__placeholder {
    min-height: 100%;
    background:
      linear-gradient(180deg, transparent 0%, rgb(0 0 0 / 55%) 100%),
      repeating-linear-gradient(
        -18deg,
        var(--color-surface) 0 1px,
        transparent 1px 18px
      );
  }

  .collection-banner__inner {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: center;
    align-items: center;
    gap: clamp(2rem, 6vw, 4rem);
    width: 100%;
    max-width: var(--page-width);
    min-height: inherit;
    margin-inline: auto;
    padding: clamp(2.5rem, 8vw, 5rem) var(--page-margin);
  }

  .collection-banner__copy {
    display: grid;
    justify-items: start;
    gap: clamp(0.85rem, 1.8vw, 1.35rem);
    min-inline-size: 0;
  }

  .collection-banner__heading {
    margin: 0;
    max-inline-size: 100%;
    font-family: var(--font-display--family);
    font-style: var(--font-display--style);
    font-weight: var(--font-display--weight);
    font-size: clamp(3.25rem, 16vw, 8.75rem);
    line-height: 0.82;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .collection-banner__description {
    max-width: 22ch;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    line-height: 1.7;
  }

  .collection-banner__description p {
    margin: 0;
  }

  .collection-banner__quote {
    margin: 0;
    position: relative;
    max-width: 18ch;
    padding: 1.1rem 1.25rem;
    color: var(--color-foreground);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    line-height: 1.7;
    text-transform: uppercase;
  }

  .collection-banner__quote::before,
  .collection-banner__quote::after,
  .collection-banner__quote-frame::before,
  .collection-banner__quote-frame::after {
    content: '';
    position: absolute;
    width: 0.85rem;
    height: 0.85rem;
    pointer-events: none;
  }

  .collection-banner__quote-frame {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .collection-banner__quote::before {
    top: 0;
    left: 0;
    border-top: 1px solid currentcolor;
    border-left: 1px solid currentcolor;
  }

  .collection-banner__quote::after {
    top: 0;
    right: 0;
    border-top: 1px solid currentcolor;
    border-right: 1px solid currentcolor;
  }

  .collection-banner__quote-frame::before {
    bottom: 0;
    left: 0;
    border-bottom: 1px solid currentcolor;
    border-left: 1px solid currentcolor;
  }

  .collection-banner__quote-frame::after {
    right: 0;
    bottom: 0;
    border-right: 1px solid currentcolor;
    border-bottom: 1px solid currentcolor;
  }

  @media (min-width: 900px) {
    .collection-banner__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      justify-content: space-between;
    }

    .collection-banner__quote {
      justify-self: end;
      margin-block-end: 0.35rem;
    }
  }

  @media (max-width: 899px) {
    .collection-banner--media .collection-banner__media::after {
      background: linear-gradient(
        180deg,
        rgb(0 0 0 / 58%) 0%,
        rgb(0 0 0 / 28%) 48%,
        rgb(0 0 0 / 12%) 100%
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-banner__image {
      object-position: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_banner",
  "tag": "div",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.heading_fallback_collection",
      "default": "DROPS"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "t:labels.quote"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:labels.show_image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.hero_image",
      "info": "t:info.image_fallback_collection"
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_banner"
    }
  ]
}
{% endschema %}
