{% liquid
  assign banner_heading = section.settings.heading
  if banner_heading == blank
    assign banner_heading = collection.title
  endif

  assign banner_description = section.settings.description

  assign banner_image = section.settings.image
  if banner_image == blank
    assign banner_image = collection.image
  endif

  assign has_media = false
  if section.settings.show_image
    if banner_image != blank
      assign has_media = true
    endif
  endif
%}

<section class="collection-banner full-width{% if has_media %} collection-banner--media{% endif %}">
  <div class="collection-banner__inner">
    <div class="collection-banner__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow collection-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if banner_heading != blank %}
        <h1 class="collection-banner__heading">{{ banner_heading | escape }}</h1>
      {% endif %}

      {% if banner_description != blank %}
        <div class="rte collection-banner__description">{{ banner_description }}</div>
      {% endif %}

      {% if section.settings.pagination != blank %}
        <p class="collection-banner__pagination">{{ section.settings.pagination | escape }}</p>
      {% endif %}
    </div>

    {% if has_media %}
      <div class="collection-banner__media">
        {{
          banner_image
          | image_url: width: 1800
          | image_tag:
            class: 'collection-banner__image',
            widths: '750, 1100, 1400, 1800',
            sizes: '(min-width: 900px) 52vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .collection-banner {
    border-bottom: 1px solid var(--color-border);
  }

  .collection-banner__inner {
    display: grid;
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .collection-banner__copy {
    display: grid;
    align-content: end;
    justify-items: start;
    gap: clamp(0.85rem, 1.8vw, 1.35rem);
    min-inline-size: 0;
    padding: clamp(2.25rem, 6vw, 4.5rem) var(--page-margin);
  }

  .collection-banner__heading {
    margin: 0;
    max-inline-size: 100%;
    font-family: var(--font-display--family);
    font-style: var(--font-display--style);
    font-weight: var(--font-display--weight);
    font-size: clamp(3.25rem, 16vw, 8.75rem);
    line-height: 0.82;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .collection-banner__description {
    max-width: 36ch;
  }

  .collection-banner__pagination {
    margin: 0;
    margin-block-start: clamp(1.25rem, 4vw, 2.5rem);
    color: var(--color-foreground-subtle);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .collection-banner__media {
    position: relative;
    min-block-size: min(70vw, 28rem);
    overflow: hidden;
    background: var(--color-surface);
  }

  .collection-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .collection-banner--media .collection-banner__inner {
      grid-template-columns: minmax(16rem, 0.9fr) minmax(0, 1.1fr);
      min-block-size: min(72svh, 38rem);
    }

    .collection-banner__copy {
      padding-inline-end: clamp(1.5rem, 4vw, 3.5rem);
    }

    .collection-banner__media {
      min-block-size: 100%;
    }
  }

  @media (max-width: 899px) {
    .collection-banner__media {
      aspect-ratio: 4 / 5;
      min-block-size: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_banner",
  "tag": "div",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "01 // DROP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.heading_fallback_collection"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "text",
      "id": "pagination",
      "label": "t:labels.pagination"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:labels.show_image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.image_fallback_collection"
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_banner"
    }
  ]
}
{% endschema %}
