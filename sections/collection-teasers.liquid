{% if section.blocks.size > 0 %}
<section class="collection-teasers full-width section-pad">
  <div class="collection-teasers__inner page-inner">
    <header class="collection-teasers__header">
      {% if section.settings.heading != blank %}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.link_label != blank %}
        <a
          class="collection-teasers__all"
          href="{{ section.settings.link_url | default: '/collections/drop-001' }}"
        >
          {{ section.settings.link_label | escape }}
        </a>
      {% endif %}
    </header>

    {% if section.blocks.size > 0 %}
      <ul class="collection-teasers__grid" role="list">
        {% for block in section.blocks %}
          {% liquid
            assign card_url = block.settings.link
            if card_url == blank and block.settings.collection != blank
              assign card_url = block.settings.collection.url
            endif

            assign is_coming_soon = block.settings.coming_soon
            if is_coming_soon
              assign card_url = blank
            endif
          %}

          <li class="collection-teasers__item" {{ block.shopify_attributes }}>
            {% if card_url != blank %}
              <a class="collection-teasers__card" href="{{ card_url }}">
            {% else %}
              <div class="collection-teasers__card collection-teasers__card--static">
            {% endif %}
              <div class="collection-teasers__media">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      class: 'collection-teasers__image',
                      widths: '320, 480, 640, 900',
                      sizes: '(min-width: 1100px) 18vw, (min-width: 750px) 30vw, 80vw',
                      loading: 'lazy'
                  }}
                {% else %}
                  <span class="collection-teasers__placeholder" aria-hidden="true"></span>
                {% endif %}
              </div>

              <div class="collection-teasers__copy">
                {% if block.settings.title != blank %}
                  <h3 class="collection-teasers__title">{{ block.settings.title | escape }}</h3>
                {% endif %}

                {% if block.settings.status != blank %}
                  <p class="collection-teasers__status">{{ block.settings.status | escape }}</p>
                {% endif %}
              </div>
            {% if card_url != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>
{% endif %}

{% stylesheet %}
  .collection-teasers__inner {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  .collection-teasers__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .collection-teasers__all {
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-foreground-muted);
  }

  .collection-teasers__all:hover,
  .collection-teasers__all:focus-visible {
    color: var(--color-foreground);
  }

  .collection-teasers__grid {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-auto-flow: column;
    grid-auto-columns: minmax(14rem, 18rem);
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .collection-teasers__card,
  .collection-teasers__card--static {
    display: grid;
    gap: 0.9rem;
    color: inherit;
    text-decoration: none;
  }

  .collection-teasers__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .collection-teasers__image,
  .collection-teasers__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-teasers__placeholder {
    background:
      repeating-linear-gradient(
        -18deg,
        var(--color-surface-strong) 0 1px,
        transparent 1px 16px
      );
  }

  .collection-teasers__copy {
    display: grid;
    gap: 0.35rem;
  }

  .collection-teasers__title {
    margin: 0;
    font-family: var(--font-display--family);
    font-size: var(--text-lg);
    font-weight: var(--font-display--weight);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .collection-teasers__status {
    margin: 0;
    font-family: var(--font-mono--family);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  @media (min-width: 1100px) {
    .collection-teasers__grid {
      grid-auto-flow: row;
      grid-auto-columns: unset;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      overflow: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_teasers",
  "tag": "div",
  "class": "section-collection-teasers",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "EXPLORE COLLECTIONS"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.view_all",
      "default": "VIEW ALL →"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:labels.link_url"
    }
  ],
  "blocks": [
    {
      "type": "teaser",
      "name": "t:general.collection_teaser",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title"
        },
        {
          "type": "text",
          "id": "status",
          "label": "t:labels.status"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link_url"
        },
        {
          "type": "checkbox",
          "id": "coming_soon",
          "label": "t:labels.coming_soon",
          "info": "t:info.coming_soon",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_teasers"
    }
  ]
}
{% endschema %}
