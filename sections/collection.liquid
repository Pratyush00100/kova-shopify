{% comment %}
  Product grid for collection templates. Products, order, price and availability
  all come from Shopify. Filter labels and URLs are merchant-editable.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{% liquid
  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign grid_description = section.settings.description
  if grid_description == blank
    assign grid_description = collection.description
  endif
  assign catalog_drop = nil
  unless collection.handle == 'all'
    assign catalog_drop = collection.title
  endunless
  assign show_toolbar = false
  if section.blocks.size > 0
    assign show_toolbar = true
  endif
  if section.settings.show_sort
    assign show_toolbar = true
  endif
%}

<div class="collection full-width">
  <div class="collection__inner page-inner">
    {% if show_toolbar %}
      <div class="collection-toolbar">
        {% if section.blocks.size > 0 %}
          <nav class="collection-filters" aria-label="{{ 'accessibility.drop_filters' | t }}">
            <ul class="collection-filters__list" role="list">
              {% for block in section.blocks %}
                {% liquid
                  assign filter_url = block.settings.url
                  if filter_url == blank
                    assign filter_url = routes.all_products_collection_url
                  endif
                  assign filter_slug = filter_url | split: '?' | first | split: '/' | last
                  assign is_active = false
                  if filter_url == collection.url or filter_url == request.path
                    assign is_active = true
                  endif
                  unless is_active
                    if filter_slug != blank
                      if filter_slug == collection.handle
                        assign is_active = true
                      endif
                    endif
                  endunless
                %}
                {% if block.settings.label != blank %}
                  <li class="collection-filters__item" {{ block.shopify_attributes }}>
                    <a
                      class="collection-filters__link{% if is_active %} collection-filters__link--active{% endif %}"
                      href="{{ filter_url }}"
                      {% if is_active %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ block.settings.label | escape }}
                    </a>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </nav>
        {% endif %}

        {% if section.settings.show_sort %}
          <details class="collection-sort">
            <summary class="collection-sort__summary">
              <span>{{ 'collections.sort' | t }}</span>
              <span class="collection-sort__plus" aria-hidden="true">+</span>
            </summary>
            <ul class="collection-sort__options" role="list">
              {% for option in collection.sort_options %}
                <li>
                  <a
                    class="collection-sort__option{% if option.value == current_sort %} collection-sort__option--active{% endif %}"
                    href="{{ collection.url | sort_by: option.value }}"
                    {% if option.value == current_sort %}
                      aria-current="true"
                    {% endif %}
                  >
                    {{ option.name }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </details>
        {% endif %}
      </div>
    {% endif %}

    <header class="collection__header">
      <div class="collection__header-row">
        {% if section.settings.current_drop != blank %}
          <p class="collection__kicker">
            <span>{{ section.settings.current_drop | escape }}</span>
            <span class="collection__rule" aria-hidden="true"></span>
          </p>
        {% endif %}

        <p class="collection__count">
          {{- 'collections.catalog_count' | t: count: collection.products_count -}}
        </p>
      </div>

      {% if collection.title != blank %}
        <h2 class="collection__title">{{ collection.title | escape }}</h2>
      {% endif %}

      {% if grid_description != blank %}
        <div class="rte collection__description">{{ grid_description }}</div>
      {% endif %}
    </header>

    {% paginate collection.products by section.settings.products_per_page %}
      {% if collection.products.size > 0 %}
        <ul class="collection__grid" role="list" style="--columns: {{ section.settings.columns }}">
          {% for product in collection.products %}
            {% assign card_index = paginate.current_offset | plus: forloop.index %}
            <li class="collection__item">
              {% render 'product-card',
                product: product,
                layout: 'catalog',
                card_index: card_index,
                drop_label: catalog_drop,
                show_price: section.settings.show_price
              %}
            </li>
          {% endfor %}
        </ul>

        {% if paginate.pages > 1 %}
          <nav class="collection__pagination" aria-label="{{ 'accessibility.pagination' | t }}">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}
      {% else %}
        <div class="collection__empty">
          <p class="collection__empty-message">{{ 'collections.empty' | t }}</p>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% stylesheet %}
  .collection {
    padding-block: clamp(1.5rem, 3vw, 2.25rem) var(--space-section);
  }

  .collection__inner {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 3rem);
  }

  .collection-toolbar {
    display: flex;
    align-items: center;
    gap: 0.75rem 1.25rem;
    min-width: 0;
    padding-block: 0.15rem 0.35rem;
    border-bottom: 1px solid var(--color-border);
  }

  .collection-filters {
    min-width: 0;
    flex: 1 1 auto;
  }

  .collection-filters__list {
    display: flex;
    align-items: center;
    gap: 0.25rem 1.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .collection-filters__item {
    flex: 0 0 auto;
  }

  .collection-filters__link,
  .collection-sort__summary {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.35rem 0;
    border: 0;
    background: transparent;
    color: var(--color-foreground-muted);
    text-decoration: none;
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
  }

  .collection-filters__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.35rem;
    height: 1px;
    background: var(--color-foreground);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--duration) var(--ease-out);
  }

  .collection-filters__link:hover,
  .collection-filters__link:focus-visible,
  .collection-filters__link--active {
    color: var(--color-foreground);
  }

  .collection-filters__link:hover::after,
  .collection-filters__link:focus-visible::after,
  .collection-filters__link--active::after {
    transform: scaleX(1);
  }

  .collection-sort {
    position: relative;
    flex: 0 0 auto;
    margin-inline-start: auto;
  }

  .collection-sort > summary {
    list-style: none;
  }

  .collection-sort > summary::-webkit-details-marker {
    display: none;
  }

  .collection-sort__plus {
    display: inline-block;
    transition: transform var(--duration) var(--ease-out);
  }

  .collection-sort[open] .collection-sort__plus {
    transform: rotate(45deg);
  }

  .collection-sort[open] .collection-sort__summary {
    color: var(--color-foreground);
  }

  .collection-sort__options {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 8;
    display: grid;
    min-width: 12.5rem;
    margin: 0;
    padding: 0.4rem 0;
    list-style: none;
    border: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .collection-sort__option {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.35rem 0.9rem;
    color: var(--color-foreground-muted);
    text-decoration: none;
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .collection-sort__option:hover,
  .collection-sort__option:focus-visible,
  .collection-sort__option--active {
    color: var(--color-foreground);
    background: var(--color-surface);
  }

  .collection__header {
    display: grid;
    gap: 0.85rem;
  }

  .collection__header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem 1.25rem;
  }

  .collection__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .collection__rule {
    display: block;
    width: 2.75rem;
    height: 1px;
    background: var(--color-border-strong);
  }

  .collection__count {
    margin: 0;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .collection__title {
    margin: 0;
    font-family: var(--font-display--family);
    font-style: var(--font-display--style);
    font-weight: var(--font-display--weight);
    font-size: clamp(1.65rem, 3.4vw, 2.6rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .collection__description {
    max-width: 46ch;
  }

  .collection__grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem) clamp(0.85rem, 1.8vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .collection__pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1rem;
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--color-border);
    color: var(--color-foreground-muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .collection__pagination a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s var(--ease-out);
  }

  .collection__pagination a:hover,
  .collection__pagination a:focus-visible {
    color: var(--color-foreground);
    border-bottom-color: currentcolor;
  }

  .collection__pagination .current {
    color: var(--color-foreground);
  }

  .collection__empty {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding-block: clamp(3rem, 8vw, 5rem);
    border-top: 1px solid var(--color-border);
  }

  .collection__empty-message {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  @media (min-width: 900px) {
    .collection__grid {
      grid-template-columns: repeat(var(--columns, 4), minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-filters__link::after,
    .collection-sort__plus,
    .collection__pagination a {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "text",
      "id": "current_drop",
      "label": "t:labels.current_drop",
      "default": "CURRENT DROP"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description",
      "info": "t:info.description_fallback_collection"
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "t:labels.show_sort",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:labels.products_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:labels.show_price",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "t:general.drop_filter",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.filter_label",
          "default": "ALL"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:labels.filter_url",
          "info": "t:info.empty_url_all_products"
        }
      ]
    }
  ]
}
{% endschema %}
