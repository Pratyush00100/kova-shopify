{% comment %}
  This section is used in the collection template to render the product grid
  for a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div class="collection full-width section-pad">
  <div class="collection__inner page-inner">
    {% paginate collection.products by section.settings.products_per_page %}
      {% if collection.products.size > 0 %}
        <ul class="collection__grid" role="list" style="--columns: {{ section.settings.columns }}">
          {% for product in collection.products %}
            <li class="collection__item">
              {% render 'product-card', product: product, show_price: section.settings.show_price %}
            </li>
          {% endfor %}
        </ul>

        {% if paginate.pages > 1 %}
          <nav class="collection__pagination" aria-label="{{ 'accessibility.pagination' | t }}">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}
      {% else %}
        <div class="collection__empty">
          <p class="section-title">{{ 'collections.empty' | t }}</p>
          <a class="link-underline" href="{{ routes.all_products_collection_url }}">
            {{ 'collections.view_all' | t }}
          </a>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% stylesheet %}
  .collection__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .collection__grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }

  .collection__pagination {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .collection__empty {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-block: clamp(2rem, 6vw, 4rem);
  }

  @media (min-width: 600px) {
    .collection__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .collection__grid {
      grid-template-columns: repeat(var(--columns, 3), 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:labels.products_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:labels.show_price",
      "default": true
    }
  ]
}
{% endschema %}
