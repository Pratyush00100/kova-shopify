{% comment %}
  Product grid for collection templates. Products, order, price and availability
  all come from Shopify. Pagination stays in place as a safety mechanism.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div class="collection full-width section-pad">
  <div class="collection__inner page-inner">
    {% paginate collection.products by section.settings.products_per_page %}
      {% if collection.products.size > 0 %}
        <ul class="collection__grid" role="list" style="--columns: {{ section.settings.columns }}">
          {% for product in collection.products %}
            <li class="collection__item">
              {% render 'product-card', product: product, show_price: section.settings.show_price %}
            </li>
          {% endfor %}
        </ul>

        {% if paginate.pages > 1 %}
          <nav class="collection__pagination" aria-label="{{ 'accessibility.pagination' | t }}">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}
      {% else %}
        <div class="collection__empty">
          <p class="collection__empty-message">{{ 'collections.empty' | t }}</p>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% stylesheet %}
  .collection__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  /* Row gap carries the title/price block; the tighter column gap keeps the
     photography large across the row. */
  .collection__grid {
    display: grid;
    gap: clamp(2.25rem, 4.5vw, 3.75rem) clamp(1.25rem, 2.5vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }

  .collection__pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1rem;
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--color-border);
    color: var(--color-foreground-muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .collection__pagination a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s var(--ease-out);
  }

  .collection__pagination a:hover,
  .collection__pagination a:focus-visible {
    color: var(--color-foreground);
    border-bottom-color: currentcolor;
  }

  .collection__pagination .current {
    color: var(--color-foreground);
  }

  .collection__empty {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding-block: clamp(3rem, 8vw, 5rem);
    border-top: 1px solid var(--color-border);
  }

  .collection__empty-message {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  @media (min-width: 600px) {
    .collection__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .collection__grid {
      grid-template-columns: repeat(var(--columns, 3), 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collection__pagination a {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:labels.products_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:labels.show_price",
      "default": true
    }
  ]
}
{% endschema %}
