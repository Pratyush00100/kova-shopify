{% comment %}
  Homepage contact block. Email and WhatsApp only — no form, no extra pages.
  Topic cards open those same channels with a prefilled subject or message.
{% endcomment %}

{% liquid
  assign wa_number = section.settings.whatsapp_number | replace: ' ', '' | replace: '+', '' | replace: '-', '' | replace: '(', '' | replace: ')', ''
  assign phone_label = section.settings.phone_display | default: section.settings.whatsapp_number
  assign email_address = section.settings.email
  assign mailto_base = ''
  if email_address != blank
    assign mailto_base = 'mailto:' | append: email_address
  endif
  assign whatsapp_base = ''
  if wa_number != blank
    assign whatsapp_base = 'https://wa.me/' | append: wa_number
  endif
%}

<section
  class="contact full-width"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id | handle }}"
  {% endif %}
>
  <div class="contact__inner page-inner">
    <header class="contact__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow eyebrow--marked">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="contact__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="contact__description">{{ section.settings.description }}</div>
      {% endif %}
    </header>

    {% if section.blocks.size > 0 %}
      <ul class="contact__topics" role="list">
        {% for block in section.blocks %}
          {% liquid
            assign topic_mailto = mailto_base
            if topic_mailto != blank
              if block.settings.email_subject != blank
                assign encoded_subject = block.settings.email_subject | url_encode
                assign topic_mailto = topic_mailto | append: '?subject=' | append: encoded_subject
              endif
            endif

            assign topic_whatsapp = whatsapp_base
            if topic_whatsapp != blank
              if block.settings.whatsapp_message != blank
                assign encoded_message = block.settings.whatsapp_message | url_encode
                assign topic_whatsapp = topic_whatsapp | append: '?text=' | append: encoded_message
              endif
            endif
          %}

          <li class="contact__topic" {{ block.shopify_attributes }}>
            <div class="contact__topic-copy">
              {% if block.settings.title != blank %}
                <h3 class="contact__topic-title">{{ block.settings.title | escape }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <p class="contact__topic-text">{{ block.settings.text | escape }}</p>
              {% endif %}
            </div>

            {% if topic_mailto != blank %}
              <div class="contact__topic-actions">
                <a class="contact__topic-link" href="{{ topic_mailto }}">
                  {{ 'contact.email' | t }}
                </a>
                {% if topic_whatsapp != blank %}
                  <a
                    class="contact__topic-link"
                    href="{{ topic_whatsapp }}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {{ 'contact.whatsapp' | t }}
                  </a>
                {% endif %}
              </div>
            {% elsif topic_whatsapp != blank %}
              <div class="contact__topic-actions">
                <a
                  class="contact__topic-link"
                  href="{{ topic_whatsapp }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {{ 'contact.whatsapp' | t }}
                </a>
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if mailto_base != blank %}
      <div class="contact__details">
        {% if section.settings.details_heading != blank %}
          <h3 class="contact__details-heading">{{ section.settings.details_heading | escape }}</h3>
        {% endif %}

        <ul class="contact__channels" role="list">
          <li class="contact__channel">
            <p class="contact__channel-label">{{ 'contact.email' | t }}</p>
            <a class="contact__channel-value" href="{{ mailto_base }}">{{ email_address | escape }}</a>
          </li>

          {% if whatsapp_base != blank %}
            <li class="contact__channel">
              <p class="contact__channel-label">{{ 'contact.whatsapp' | t }}</p>
              <a
                class="btn btn--arrow contact__whatsapp"
                href="{{ whatsapp_base }}"
                target="_blank"
                rel="noopener noreferrer"
              >
                {{ phone_label | escape }}
              </a>
            </li>
          {% endif %}
        </ul>
      </div>
    {% elsif whatsapp_base != blank %}
      <div class="contact__details">
        {% if section.settings.details_heading != blank %}
          <h3 class="contact__details-heading">{{ section.settings.details_heading | escape }}</h3>
        {% endif %}

        <ul class="contact__channels" role="list">
          <li class="contact__channel">
            <p class="contact__channel-label">{{ 'contact.whatsapp' | t }}</p>
            <a
              class="btn btn--arrow contact__whatsapp"
              href="{{ whatsapp_base }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              {{ phone_label | escape }}
            </a>
          </li>
        </ul>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .contact {
    scroll-margin-top: var(--header-height);
    padding-block: var(--space-section-lg);
    border-top: 1px solid var(--color-border);
  }

  .contact__inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  .contact__intro {
    display: grid;
    gap: 1rem;
  }

  .contact__heading {
    margin: 0;
    max-width: 12ch;
    font-family: var(--font-display--family);
    font-style: var(--font-display--style);
    font-weight: var(--font-display--weight);
    font-size: var(--display-md);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .contact__description {
    max-width: 46ch;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .contact__description p {
    margin: 0;
  }

  .contact__topics {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--color-border);
    grid-template-columns: minmax(0, 1fr);
  }

  .contact__topic {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    min-width: 0;
    padding: clamp(1.35rem, 3vw, 1.85rem);
    border-bottom: 1px solid var(--color-border);
  }

  .contact__topic:last-child {
    border-bottom: 0;
  }

  .contact__topic-copy {
    display: grid;
    gap: 0.55rem;
    width: 100%;
  }

  .contact__topic-title {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    font-family: var(--font-display--family);
    font-style: var(--font-display--style);
    font-weight: var(--font-display--weight);
    font-size: var(--text-xl);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .contact__topic-title::after {
    content: '->';
    flex: 0 0 auto;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
  }

  .contact__topic-text {
    margin: 0;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    line-height: 1.6;
  }

  .contact__topic-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .contact__topic-link {
    color: var(--color-foreground);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border-strong);
    padding-bottom: 0.15rem;
    transition:
      color var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out);
  }

  .contact__topic-link:hover,
  .contact__topic-link:focus-visible {
    color: var(--color-foreground);
    border-bottom-color: var(--color-foreground);
  }

  .contact__details {
    display: grid;
    gap: 1.5rem;
    padding-top: clamp(0.5rem, 2vw, 1rem);
    border-top: 1px solid var(--color-border);
  }

  .contact__details-heading {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0;
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .contact__details-heading::before {
    content: '↗';
    font-size: 1em;
    line-height: 1;
  }

  .contact__channels {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact__channel {
    display: grid;
    justify-items: start;
    gap: 0.65rem;
  }

  .contact__channel-label {
    margin: 0;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .contact__channel-value {
    color: inherit;
    font-family: var(--font-mono--family);
    font-size: var(--text-base);
    letter-spacing: 0.04em;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border-strong);
    padding-bottom: 0.2rem;
    transition: border-color var(--duration) var(--ease-out);
  }

  .contact__channel-value:hover,
  .contact__channel-value:focus-visible {
    border-bottom-color: var(--color-foreground);
  }

  .contact__whatsapp {
    justify-self: start;
  }

  @media (min-width: 900px) {
    .contact__topics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .contact__topic {
      border-bottom: 0;
      border-right: 1px solid var(--color-border);
    }

    .contact__topic:last-child {
      border-right: 0;
    }

    .contact__channels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(3rem, 8vw, 8rem);
      max-width: 42rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__topic-link,
    .contact__channel-value {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact",
  "tag": "div",
  "class": "section-contact",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:labels.anchor_id",
      "default": "contact"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "KOVA // CONTACT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "LET'S MAKE SOMETHING."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description",
      "default": "<p>Questions, custom dimensions, collaborations or just want to talk?</p>"
    },
    {
      "type": "text",
      "id": "details_heading",
      "label": "t:labels.details_heading",
      "default": "GET IN TOUCH"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:labels.email",
      "default": "kovaa.cool@gmail.com"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "t:labels.whatsapp_number",
      "default": "917988355887",
      "info": "t:info.whatsapp_number"
    },
    {
      "type": "text",
      "id": "phone_display",
      "label": "t:labels.phone_display",
      "default": "+91 7988355887",
      "info": "t:info.phone_display"
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "t:general.contact_topic",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "CUSTOM"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "Custom size / design enquiry"
        },
        {
          "type": "text",
          "id": "email_subject",
          "label": "t:labels.email_subject",
          "info": "t:info.email_subject"
        },
        {
          "type": "text",
          "id": "whatsapp_message",
          "label": "t:labels.whatsapp_message",
          "info": "t:info.contact_whatsapp_message"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.contact",
      "blocks": [
        {
          "type": "topic",
          "settings": {
            "title": "CUSTOM",
            "text": "Custom size / design enquiry",
            "email_subject": "Custom enquiry",
            "whatsapp_message": "Hi KOVA — I have a custom size / design enquiry."
          }
        },
        {
          "type": "topic",
          "settings": {
            "title": "SUPPORT",
            "text": "Order / delivery / product help",
            "email_subject": "Support",
            "whatsapp_message": "Hi KOVA — I need help with an order."
          }
        },
        {
          "type": "topic",
          "settings": {
            "title": "COLLAB",
            "text": "Brands / creators / events",
            "email_subject": "Collaboration",
            "whatsapp_message": "Hi KOVA — I would like to talk about a collaboration."
          }
        }
      ]
    }
  ]
}
{% endschema %}
