{% liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
%}

<section
  class="drop-intro full-width{% if has_image %} drop-intro--illustrated{% endif %}"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id | handle }}"
  {% endif %}
>
  {% if has_image %}
    <div class="drop-intro__media" aria-hidden="true">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'drop-intro__image',
          widths: '750, 1100, 1500, 1800, 2400',
          sizes: '100vw',
          loading: 'lazy'
      }}
    </div>
  {% endif %}

  <div class="drop-intro__inner">
    <div class="drop-intro__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="drop-intro__title">{{ section.settings.title | escape }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="drop-intro__subtitle">{{ section.settings.subtitle | escape }}</p>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="drop-intro__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          class="btn btn--arrow"
          href="{{ section.settings.button_link | default: '/collections/drop-001' }}"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.pagination != blank %}
      <p class="drop-intro__pagination">{{ section.settings.pagination | escape }}</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .drop-intro {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: min(72vw, 38rem);
    overflow: hidden;
    background: var(--color-surface);
  }

  .drop-intro__media,
  .drop-intro__inner {
    grid-area: 1 / 1;
  }

  .drop-intro__media {
    z-index: 0;
  }

  .drop-intro__image {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
  }

  .drop-intro::after {
    content: '';
    grid-area: 1 / 1;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgb(0 0 0 / 78%) 0%,
      rgb(0 0 0 / 42%) 42%,
      rgb(0 0 0 / 18%) 100%
    );
    pointer-events: none;
  }

  .drop-intro:not(.drop-intro--illustrated)::after {
    background: linear-gradient(180deg, rgb(0 0 0 / 20%), rgb(0 0 0 / 55%));
  }

  .drop-intro__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding: clamp(2.5rem, 7vw, 5rem) var(--page-margin);
  }

  .drop-intro__copy {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 36rem;
  }

  .drop-intro__title {
    margin: 0;
    font-family: var(--font-display--family);
    font-style: var(--font-display--style);
    font-weight: var(--font-display--weight);
    font-size: clamp(2.75rem, 8vw, 6.25rem);
    line-height: 0.88;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .drop-intro__subtitle {
    margin: 0;
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .drop-intro__description {
    max-width: 38ch;
    color: var(--color-foreground-muted);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .drop-intro__description p {
    margin: 0;
  }

  .drop-intro__pagination {
    align-self: end;
    margin: 0;
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-foreground-subtle);
  }

  @media (min-width: 900px) {
    .drop-intro {
      min-height: min(78vh, 44rem);
    }

    .drop-intro__inner {
      flex-direction: row;
      align-items: flex-end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.drop_intro",
  "tag": "div",
  "class": "section-drop-intro",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:labels.anchor_id",
      "default": "drop"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "CURRENT DROP"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "VELOCITY // 001"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:labels.subheading",
      "default": "AUTOMOTIVE SILHOUETTES"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "VIEW COLLECTION"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "text",
      "id": "pagination",
      "label": "t:labels.pagination",
      "default": "01 —— 05"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.assigned_image_only"
    }
  ],
  "presets": [
    {
      "name": "t:general.drop_intro"
    }
  ]
}
{% endschema %}
