{% comment %}
  Editorial transition from the hero into the current release. The media column
  is only built when an image exists, so the section reads as a deliberate
  typographic composition until real photography arrives.
{% endcomment %}

{% liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
%}

<section
  class="drop-intro full-width{% if has_image %} drop-intro--illustrated{% endif %}"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id | handle }}"
  {% endif %}
>
  <div class="drop-intro__inner">
    <div class="drop-intro__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="drop-intro__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="drop-intro__title">{{ section.settings.title | escape }}</h2>
      {% endif %}

      {% if section.settings.description != blank or section.settings.button_label != blank %}
        <div class="drop-intro__body">
          {% if section.settings.description != blank %}
            <div class="drop-intro__description">
              {{ section.settings.description }}
            </div>
          {% endif %}

          {% if section.settings.button_label != blank %}
            <a
              class="drop-intro__cta"
              href="{{ section.settings.button_link | default: '/collections/drop-001' }}"
            >
              {{ section.settings.button_label | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if has_image %}
      <div class="drop-intro__media">
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            class: 'drop-intro__image',
            widths: '600, 900, 1200, 1500, 1800',
            sizes: '(min-width: 900px) 55vw, 100vw',
            loading: 'lazy'
        }}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .drop-intro {
    padding-block: clamp(4.5rem, 12vw, 9rem);
  }

  .drop-intro__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .drop-intro__copy {
    display: grid;
    align-content: start;
    gap: clamp(1.1rem, 2vw, 1.6rem);
  }

  .drop-intro__eyebrow {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .drop-intro__title {
    margin: 0;
    font-size: clamp(3.25rem, 9vw, 7rem);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .drop-intro__body {
    display: grid;
    justify-items: start;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .drop-intro__description {
    color: var(--color-foreground-muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 32ch;
  }

  .drop-intro__description p {
    margin: 0;
  }

  .drop-intro__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-bottom: 0.2rem;
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    box-shadow: inset 0 -1px 0 currentcolor;
    transition: box-shadow 0.3s var(--ease-out);
  }

  .drop-intro__cta:hover,
  .drop-intro__cta:focus-visible {
    box-shadow: inset 0 -1px 0 transparent;
  }

  .drop-intro__media {
    overflow: hidden;
    background: var(--color-surface);
  }

  .drop-intro__image {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    /* Without photography the section becomes a two-part editorial spread:
       the release name leads, the supporting line settles on its baseline. */
    .drop-intro:not(.drop-intro--illustrated) .drop-intro__copy {
      grid-template-columns: minmax(0, 1fr) minmax(0, 23rem);
      column-gap: clamp(3rem, 8vw, 8rem);
      align-items: end;
    }

    .drop-intro:not(.drop-intro--illustrated) .drop-intro__eyebrow {
      grid-column: 1 / -1;
    }

    .drop-intro:not(.drop-intro--illustrated) .drop-intro__title {
      grid-column: 1;
      margin-bottom: -0.12em;
    }

    .drop-intro:not(.drop-intro--illustrated) .drop-intro__body {
      grid-column: 2;
    }

    .drop-intro--illustrated .drop-intro__inner {
      grid-template-columns: minmax(16rem, 0.9fr) minmax(0, 1.35fr);
      align-items: end;
    }

    .drop-intro--illustrated .drop-intro__image {
      aspect-ratio: 5 / 4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drop-intro__cta {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.drop_intro",
  "tag": "div",
  "class": "section-drop-intro",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:labels.anchor_id",
      "default": "drop"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "DROP 001"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "VELOCITY"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "VIEW THE DROP"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.assigned_image_only"
    }
  ],
  "presets": [
    {
      "name": "t:general.drop_intro"
    }
  ]
}
{% endschema %}
