{% comment %}
  FAQ page: categories and answers from Shopify metaobjects, with theme-editor
  blocks as a fallback until Custom data exists.
{% endcomment %}

{% liquid
  assign faq_categories = section.settings.faq_categories
  assign faq_source = 'metaobjects'

  if faq_categories == blank or faq_categories.size == 0
    assign shop_categories = shop.metaobjects.faq_category.values
    if shop_categories.size > 0
      assign faq_categories = shop_categories
    else
      assign faq_source = 'blocks'
    endif
  endif

  assign has_categories = false
  if faq_source == 'metaobjects'
    if faq_categories.size > 0
      assign has_categories = true
    endif
  else
    for block in section.blocks
      assign block_category = block.settings.category | strip
      if block_category != blank
        assign has_categories = true
        break
      endif
    endfor
  endif

  assign json_first = true
%}

<section class="faq full-width" id="faq">
  <div class="faq__intro page-inner">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow eyebrow--marked">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="display-title faq__heading">{{ section.settings.heading | escape }}</h1>
    {% endif %}
  </div>

  <div class="faq__body page-inner">
    <div class="faq__grid">
      <div class="faq__list">
        {% if has_categories %}
          {% if faq_source == 'metaobjects' %}
            {% for category in faq_categories %}
              {% liquid
                assign category_title = category.title.value | default: category.title | strip
                assign entries = category.entries.value
                if entries == blank
                  assign entries = category.entries
                endif
              %}
              {% if category_title != blank %}
                {% assign category_handle = category.system.handle | default: forloop.index %}
                <details class="faq-category" name="faq-{{ section.id }}">
                  <summary class="faq-category__summary">
                    <span class="faq-category__title">{{ category_title | escape }}</span>
                    <span class="faq-toggle" aria-hidden="true">
                      <span class="faq-toggle__plus">+</span>
                      <span class="faq-toggle__close">&times;</span>
                    </span>
                  </summary>

                  {% if entries.size > 0 %}
                    <div class="faq-category__panel">
                      {% for entry in entries %}
                        {% liquid
                          assign question = entry.question.value | default: entry.question | strip
                          assign answer_html = entry.answer | metafield_tag
                          if answer_html == blank
                            assign answer_html = entry.answer.value
                          endif
                        %}
                        {% if question != blank %}
                          <details class="faq-entry" name="faq-{{ section.id }}-{{ category_handle }}">
                            <summary class="faq-entry__summary">
                              <span>{{ question | escape }}</span>
                              <span class="faq-toggle" aria-hidden="true">
                                <span class="faq-toggle__plus">+</span>
                                <span class="faq-toggle__close">&times;</span>
                              </span>
                            </summary>
                            {% if answer_html != blank %}
                              <div class="rte faq-entry__answer">{{ answer_html }}</div>
                            {% endif %}
                          </details>
                        {% endif %}
                      {% endfor %}
                    </div>
                  {% endif %}
                </details>
              {% endif %}
            {% endfor %}
          {% else %}
            {% assign rendered_keys = ',' %}
            {% for block in section.blocks %}
              {% liquid
                assign category_title = block.settings.category | strip
                assign category_key = category_title | handleize
                assign wrapped_key = ',' | append: category_key | append: ','
              %}
              {% if category_title != blank %}
                {% unless rendered_keys contains wrapped_key %}
                  {% assign rendered_keys = rendered_keys | append: category_key | append: ',' %}
                  <details class="faq-category" name="faq-{{ section.id }}">
                    <summary class="faq-category__summary">
                      <span class="faq-category__title">{{ category_title | escape }}</span>
                      <span class="faq-toggle" aria-hidden="true">
                        <span class="faq-toggle__plus">+</span>
                        <span class="faq-toggle__close">&times;</span>
                      </span>
                    </summary>

                    <div class="faq-category__panel">
                      {% for entry in section.blocks %}
                        {% liquid
                          assign entry_category = entry.settings.category | strip | handleize
                          assign question = entry.settings.question | strip
                          assign answer_html = entry.settings.answer
                        %}
                        {% if entry_category == category_key and question != blank %}
                          <details class="faq-entry" name="faq-{{ section.id }}-{{ category_key }}" {{ entry.shopify_attributes }}>
                            <summary class="faq-entry__summary">
                              <span>{{ question | escape }}</span>
                              <span class="faq-toggle" aria-hidden="true">
                                <span class="faq-toggle__plus">+</span>
                                <span class="faq-toggle__close">&times;</span>
                              </span>
                            </summary>
                            {% if answer_html != blank %}
                              <div class="rte faq-entry__answer">{{ answer_html }}</div>
                            {% endif %}
                          </details>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </details>
                {% endunless %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% else %}
          <p class="faq__empty">{{ 'faq.empty' | t }}</p>
        {% endif %}
      </div>

      <aside class="faq__diagram" aria-hidden="true">
        {% if section.settings.diagram_title != blank %}
          <p class="faq__diagram-title">{{ section.settings.diagram_title | escape }}</p>
        {% endif %}

        {% if section.settings.diagram_image != blank %}
          {{
            section.settings.diagram_image
            | image_url: width: 900
            | image_tag:
              class: 'faq__diagram-image',
              widths: '400, 600, 900',
              sizes: '(min-width: 900px) 32vw, 100vw',
              loading: 'lazy',
              alt: ''
          }}
        {% else %}
          <svg class="faq-elevation" viewBox="0 0 360 280" fill="none">
            <defs>
              <pattern
                id="FaqWallHatch-{{ section.id }}"
                width="10"
                height="10"
                patternUnits="userSpaceOnUse"
                patternTransform="rotate(45)"
              >
                <line
                  x1="0"
                  y1="0"
                  x2="0"
                  y2="10"
                  stroke="currentColor"
                  stroke-width="0.7"
                ></line>
              </pattern>
            </defs>

            <rect
              x="28"
              y="28"
              width="54"
              height="224"
              fill="url(#FaqWallHatch-{{ section.id }})"
              stroke="currentColor"
              stroke-width="1"
            ></rect>
            <line x1="82" y1="28" x2="82" y2="252" stroke="currentColor" stroke-width="1.2"></line>

            {% if section.settings.wall_label != blank %}
              <text class="faq-elevation__label" x="40" y="20">{{ section.settings.wall_label | escape }}</text>
            {% endif %}

            <line x1="82" y1="150" x2="118" y2="150" stroke="currentColor" stroke-width="0.8"></line>
            <line x1="82" y1="146" x2="82" y2="154" stroke="currentColor" stroke-width="0.8"></line>
            <line x1="118" y1="146" x2="118" y2="154" stroke="currentColor" stroke-width="0.8"></line>

            {% if section.settings.offset_label != blank %}
              <text class="faq-elevation__label" x="88" y="144">{{ section.settings.offset_label | escape }}</text>
            {% endif %}

            <rect
              x="118"
              y="48"
              width="36"
              height="184"
              stroke="currentColor"
              stroke-width="1.2"
            ></rect>
            <line x1="126" y1="56" x2="126" y2="224" stroke="currentColor" stroke-width="0.7"></line>

            {% if section.settings.artwork_label != blank %}
              <text class="faq-elevation__label" x="164" y="140">{{ section.settings.artwork_label | escape }}</text>
            {% endif %}
          </svg>
        {% endif %}
      </aside>
    </div>

    <div class="faq__bar">
      <svg class="faq-globe" viewBox="0 0 160 96" fill="none" aria-hidden="true">
        <ellipse cx="80" cy="48" rx="70" ry="42" stroke="currentColor" stroke-width="1"></ellipse>
        <ellipse cx="80" cy="48" rx="46" ry="42" stroke="currentColor" stroke-width="0.8"></ellipse>
        <ellipse cx="80" cy="48" rx="22" ry="42" stroke="currentColor" stroke-width="0.8"></ellipse>
        <line x1="10" y1="48" x2="150" y2="48" stroke="currentColor" stroke-width="0.8"></line>
        <ellipse cx="80" cy="48" rx="70" ry="14" stroke="currentColor" stroke-width="0.8"></ellipse>
        <ellipse cx="80" cy="48" rx="70" ry="28" stroke="currentColor" stroke-width="0.8"></ellipse>
      </svg>

      <p class="faq__coords">
        {% if section.settings.coord_north != blank %}
          <span>{{ section.settings.coord_north | escape }}</span>
        {% endif %}
        {% if section.settings.coord_east != blank %}
          <span>{{ section.settings.coord_east | escape }}</span>
        {% endif %}
      </p>

      {% if section.settings.slogan != blank %}
        <p class="faq__slogan">{{ section.settings.slogan | escape }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% if has_categories %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- if faq_source == 'metaobjects' -%}
          {%- for category in faq_categories -%}
            {%- assign entries = category.entries.value -%}
            {%- if entries == blank -%}
              {%- assign entries = category.entries -%}
            {%- endif -%}
            {%- for entry in entries -%}
              {%- assign question = entry.question.value | default: entry.question | strip -%}
              {%- assign answer_html = entry.answer | metafield_tag -%}
              {%- if answer_html == blank -%}
                {%- assign answer_html = entry.answer.value -%}
              {%- endif -%}
              {%- assign answer_plain = answer_html | strip_html | strip -%}
              {%- if question != blank -%}
                {%- unless json_first -%},{%- endunless -%}
                {
                  "@type": "Question",
                  "name": {{ question | json }},
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": {{ answer_plain | json }}
                  }
                }
                {%- assign json_first = false -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- else -%}
          {%- for entry in section.blocks -%}
            {%- assign question = entry.settings.question | strip -%}
            {%- assign answer_plain = entry.settings.answer | strip_html | strip -%}
            {%- if question != blank -%}
              {%- unless json_first -%},{%- endunless -%}
              {
                "@type": "Question",
                "name": {{ question | json }},
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": {{ answer_plain | json }}
                }
              }
              {%- assign json_first = false -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      ]
    }
  </script>
{% endif %}

{% stylesheet %}
  .faq {
    border-top: 1px solid var(--color-border);
    content-visibility: auto;
    contain-intrinsic-size: auto 48rem;
  }

  .faq__intro {
    display: grid;
    gap: 1.15rem;
    padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(1.75rem, 4vw, 3rem);
  }

  .faq__heading {
    max-width: 16ch;
    font-size: var(--display-lg);
  }

  .faq__grid {
    display: grid;
    border-top: 1px solid var(--color-border);
  }

  .faq__list {
    min-width: 0;
  }

  .faq__empty {
    margin: 0;
    padding-block: 1.5rem;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .faq-category {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-category__summary,
  .faq-entry__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
    cursor: pointer;
  }

  .faq-category__summary::-webkit-details-marker,
  .faq-entry__summary::-webkit-details-marker {
    display: none;
  }

  .faq-category__summary {
    padding-block: 1.35rem;
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .faq-category__title {
    min-width: 0;
  }

  .faq-toggle {
    flex: 0 0 auto;
    color: var(--color-foreground);
    font-size: 1.05rem;
    line-height: 1;
  }

  .faq-toggle__close {
    display: none;
  }

  .faq-category[open] > .faq-category__summary .faq-toggle__plus,
  .faq-entry[open] > .faq-entry__summary .faq-toggle__plus {
    display: none;
  }

  .faq-category[open] > .faq-category__summary .faq-toggle__close,
  .faq-entry[open] > .faq-entry__summary .faq-toggle__close {
    display: inline;
  }

  .faq-category__panel {
    display: grid;
    padding-bottom: 0.75rem;
  }

  .faq-entry {
    border-top: 1px solid var(--color-border);
  }

  .faq-entry__summary {
    padding: 0.95rem 0 0.95rem 0.25rem;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .faq-entry__answer {
    padding: 0 0 1.15rem 0.25rem;
    max-width: 54ch;
    font-size: var(--text-sm);
  }

  .faq__diagram {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .faq__diagram-title {
    margin: 0;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .faq__diagram-image,
  .faq-elevation,
  .faq-globe {
    width: 100%;
    height: auto;
  }

  .faq-elevation {
    max-width: 22rem;
    color: var(--color-foreground);
  }

  .faq-elevation__label {
    fill: currentColor;
    font-family: var(--font-mono--family);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .faq__bar {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-top: 1px solid var(--color-border);
  }

  .faq-globe {
    width: min(9.5rem, 42vw);
    color: var(--color-foreground);
  }

  .faq__coords,
  .faq__slogan {
    margin: 0;
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .faq__coords {
    display: grid;
    gap: 0.2rem;
    color: var(--color-foreground-muted);
  }

  .faq__slogan {
    font-weight: 700;
  }

  @media (min-width: 900px) {
    .faq__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    }

    .faq__list {
      padding-right: clamp(1.5rem, 4vw, 3rem);
    }

    .faq__diagram {
      padding-left: clamp(1.5rem, 4vw, 3rem);
      border-left: 1px solid var(--color-border);
    }

    .faq__bar {
      grid-template-columns: auto 1fr auto;
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }

    .faq__slogan {
      padding-left: clamp(1.25rem, 3vw, 2rem);
      border-left: 1px solid var(--color-border);
    }
  }

  .faq-category::details-content,
  .faq-entry::details-content {
    overflow: hidden;
    transition:
      content-visibility var(--duration) allow-discrete,
      overlay var(--duration) allow-discrete;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-category::details-content,
    .faq-entry::details-content {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.faq",
  "tag": "div",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "KOVA // FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "QUESTIONS? GOOD. WE'VE GOT ANSWERS."
    },
    {
      "type": "metaobject_list",
      "id": "faq_categories",
      "label": "t:labels.faq_categories",
      "metaobject_type": "faq_category",
      "info": "t:info.faq_categories"
    },
    {
      "type": "header",
      "content": "t:general.faq_diagram"
    },
    {
      "type": "text",
      "id": "diagram_title",
      "label": "t:labels.diagram_title",
      "default": "SIDE ELEVATION"
    },
    {
      "type": "image_picker",
      "id": "diagram_image",
      "label": "t:labels.diagram_image",
      "info": "t:info.assigned_image_only"
    },
    {
      "type": "text",
      "id": "wall_label",
      "label": "t:labels.wall_label",
      "default": "WALL"
    },
    {
      "type": "text",
      "id": "offset_label",
      "label": "t:labels.offset_label",
      "default": "15mm"
    },
    {
      "type": "text",
      "id": "artwork_label",
      "label": "t:labels.artwork_label",
      "default": "ARTWORK"
    },
    {
      "type": "header",
      "content": "t:general.faq_bar"
    },
    {
      "type": "text",
      "id": "coord_north",
      "label": "t:labels.coord_north",
      "default": "N 28.6139°"
    },
    {
      "type": "text",
      "id": "coord_east",
      "label": "t:labels.coord_east",
      "default": "E 77.2098°"
    },
    {
      "type": "text",
      "id": "slogan",
      "label": "t:labels.slogan",
      "default": "IDEAS SHAPED IN STEEL."
    }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "t:general.faq_entry",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "t:labels.category",
          "info": "t:info.faq_blocks"
        },
        {
          "type": "text",
          "id": "question",
          "label": "t:labels.question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:labels.answer"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "t:general.faq"
    }
  ]
}
{% endschema %}
