{% comment %}
  Curated product preview for the homepage. Pulls live products from a
  merchant-selected collection and links through to the full collection page.
{% endcomment %}

{% liquid
  assign featured_collection = section.settings.collection
  assign product_limit = section.settings.products_to_show
%}

<section class="featured-products full-width section-pad">
  <div class="featured-products__inner page-inner">
    <header class="featured-products__header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="section-title featured-products__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>

      {% if section.settings.link_label != blank %}
        {% liquid
          assign view_all_url = section.settings.link_url
          if view_all_url == blank and featured_collection != blank
            assign view_all_url = featured_collection.url
          endif
        %}
        <a class="link-underline" href="{{ view_all_url | default: routes.all_products_collection_url }}">
          {{ section.settings.link_label | escape }}
        </a>
      {% endif %}
    </header>

    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <ul class="featured-products__grid" role="list" style="--columns: {{ section.settings.columns }}">
        {% for product in featured_collection.products limit: product_limit %}
          <li class="featured-products__item">
            {% render 'product-card', product: product %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <ul class="featured-products__grid" role="list" style="--columns: {{ section.settings.columns }}">
        {% for i in (1..section.settings.columns) %}
          <li class="featured-products__item">
            <div class="featured-products__placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'media-placeholder' }}
            </div>
            <p class="featured-products__placeholder-label">{{ 'products.coming_soon' | t }}</p>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .featured-products {
    border-top: 1px solid var(--color-border);
  }

  .featured-products__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .featured-products__header {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .featured-products__heading {
    margin-top: 0.6rem;
  }

  .featured-products__grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }

  .featured-products__placeholder {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .featured-products__placeholder-label {
    margin: 0.9rem 0 0;
    color: var(--color-foreground-muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  @media (min-width: 600px) {
    .featured-products__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .featured-products__grid {
      grid-template-columns: repeat(var(--columns, 3), 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_products",
  "tag": "div",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "DROP 001"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "SELECTED PIECES"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:labels.link_url"
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_products"
    }
  ]
}
{% endschema %}
