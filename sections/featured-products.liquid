{% comment %}
  Curated product preview for the homepage. Pulls live products from a
  merchant-selected collection and links through to the full collection page.

  The shared product card is reused as-is. Homepage-only presentation is applied
  by scoping styles to this section so the collection grid and PDP related
  products keep their own treatment.
{% endcomment %}

{% liquid
  assign featured_collection = section.settings.collection
  assign product_limit = section.settings.products_to_show
  assign has_products = false
  if featured_collection != blank and featured_collection.products_count > 0
    assign has_products = true
  endif
%}

<section class="featured-products full-width">
  <div class="featured-products__inner page-inner">
    <header class="featured-products__header">
      <div class="featured-products__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="section-title featured-products__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>

      {% if section.settings.link_label != blank %}
        {% liquid
          assign view_all_url = section.settings.link_url
          if view_all_url == routes.all_products_collection_url
            assign view_all_url = blank
          endif
          if view_all_url == blank and featured_collection != blank and featured_collection.handle != 'all'
            assign view_all_url = featured_collection.url
          endif
          if view_all_url == blank
            assign view_all_url = collections['drop-001'].url
          endif
          if view_all_url == blank
            assign view_all_url = '/collections/drop-001'
          endif
        %}
        <a class="link-underline featured-products__link" href="{{ view_all_url }}">
          {{ section.settings.link_label | escape }}
        </a>
      {% endif %}
    </header>

    <ul class="featured-products__grid" role="list" style="--columns: {{ section.settings.columns }}">
      {% if has_products %}
        {% for product in featured_collection.products limit: product_limit %}
          <li class="featured-products__item">
            {% render 'product-card', product: product %}
          </li>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.columns) %}
          <li class="featured-products__item">
            <div class="featured-products__awaiting"></div>
            <p class="featured-products__awaiting-label">{{ 'products.coming_soon' | t }}</p>
          </li>
        {% endfor %}
      {% endif %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .featured-products {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(4.5rem, 11vw, 8.5rem);
    border-top: 1px solid var(--color-border);
  }

  .featured-products__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .featured-products__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem 2rem;
  }

  .featured-products__intro {
    display: grid;
    gap: 0.85rem;
  }

  .featured-products__heading {
    margin: 0;
  }

  .featured-products__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .featured-products__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem) clamp(1.25rem, 2.5vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }

  /* Homepage merchandising: the frame around the shared card is dropped so the
     photograph carries the row instead of a bordered tile. Scoped to this
     section only. */
  .featured-products__grid .product-card {
    gap: 1.25rem;
  }

  .featured-products__grid .product-card__media {
    aspect-ratio: 4 / 5;
    border: 0;
    background: var(--color-surface);
  }

  .featured-products__grid .product-card__info {
    gap: 0.55rem;
    padding-inline: 0.1rem;
  }

  .featured-products__grid .product-card__title {
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-wrap: balance;
  }

  .featured-products__grid .product-card__price {
    color: var(--color-foreground-muted);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }

  /* Quiet frame while a collection has no products yet. No stand-in imagery. */
  .featured-products__awaiting {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--color-border);
  }

  .featured-products__awaiting-label {
    margin: 1.25rem 0 0;
    color: var(--color-foreground-muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  @media (min-width: 600px) {
    .featured-products__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .featured-products__grid {
      grid-template-columns: repeat(var(--columns, 3), 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_products",
  "tag": "div",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "DROP 001"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "SELECTED PIECES"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:labels.link_url"
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_products"
    }
  ]
}
{% endschema %}
