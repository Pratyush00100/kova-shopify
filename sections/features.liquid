<section class="features full-width">
  <div class="features__inner page-inner">
    {% if section.blocks.size > 0 %}
      <ul class="features__grid" role="list">
        {% for block in section.blocks %}
          <li class="features__item" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <div class="features__icon">
                {{
                  block.settings.icon
                  | image_url: width: 96
                  | image_tag:
                    class: 'features__icon-image',
                    widths: '48, 72, 96',
                    sizes: '40px',
                    loading: 'lazy',
                    alt: ''
                }}
              </div>
            {% else %}
              <span class="features__icon features__icon--line" aria-hidden="true"></span>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3 class="features__title">{{ block.settings.title | escape }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p class="features__text">{{ block.settings.text | escape }}</p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .features {
    border-block: 1px solid var(--color-border);
  }

  .features__grid {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .features__item {
    display: grid;
    justify-items: start;
    gap: 0.85rem;
    padding: clamp(1.75rem, 4vw, 2.5rem) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .features__item:last-child {
    border-bottom: 0;
  }

  .features__icon {
    display: flex;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
  }

  .features__icon-image {
    width: 1.75rem;
    height: 1.75rem;
    object-fit: contain;
  }

  .features__icon--line {
    border: 1px solid var(--color-border-strong);
  }

  .features__title {
    margin: 0;
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .features__text {
    margin: 0;
    max-width: 28ch;
    color: var(--color-foreground-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  @media (min-width: 750px) {
    .features__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .features__item {
      padding: clamp(2rem, 4vw, 2.75rem) clamp(1.25rem, 3vw, 2.5rem);
      border-right: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }

    .features__item:nth-child(2n) {
      border-right: 0;
    }
  }

  @media (min-width: 1100px) {
    .features__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .features__item {
      border-bottom: 0;
    }

    .features__item:nth-child(2n) {
      border-right: 1px solid var(--color-border);
    }

    .features__item:last-child {
      border-right: 0;
    }
  }
{% endstylesheet %}

