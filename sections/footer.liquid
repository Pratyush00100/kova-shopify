<footer class="footer full-width">
  <div class="footer__inner">
    <div class="footer__top">
      <a class="footer__brand" href="{{ routes.root_url }}">
        {{ section.settings.brand_label | escape }}
      </a>

      <nav class="footer__nav" aria-label="{{ 'accessibility.footer_navigation' | t }}">
        {% if section.settings.menu != blank and section.settings.menu.links.size > 0 %}
          {% for link in section.settings.menu.links %}
            <a class="footer__link" href="{{ link.url }}">{{ link.title | escape }}</a>
          {% endfor %}
        {% else %}
          {% if section.settings.link_1_label != blank %}
            <a class="footer__link" href="{{ section.settings.link_1_url | default: '/collections/drop-001' }}">
              {{ section.settings.link_1_label | escape }}
            </a>
          {% endif %}
          {% if section.settings.link_2_label != blank and section.settings.link_2_url != blank %}
            <a class="footer__link" href="{{ section.settings.link_2_url }}">
              {{ section.settings.link_2_label | escape }}
            </a>
          {% endif %}
          {% if section.settings.link_3_label != blank %}
            <a class="footer__link" href="{{ section.settings.link_3_url | default: '/pages/build' }}">
              {{ section.settings.link_3_label | escape }}
            </a>
          {% endif %}
          {% if section.settings.link_4_label != blank %}
            <a class="footer__link" href="{{ section.settings.link_4_url | default: '/pages/manifesto' }}">
              {{ section.settings.link_4_label | escape }}
            </a>
          {% endif %}
        {% endif %}

        {% if section.settings.instagram_url != blank %}
          <a
            class="footer__link"
            href="{{ section.settings.instagram_url }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            {{ section.settings.instagram_label | escape }}
          </a>
        {% elsif section.settings.instagram_label != blank %}
          <span class="footer__link footer__link--muted">{{ section.settings.instagram_label | escape }}</span>
        {% endif %}
      </nav>
    </div>

    <p class="footer__copyright">
      &copy; {{ 'now' | date: '%Y' }}
      {{ section.settings.copyright_text | default: shop.name | escape }}
    </p>
  </div>
</footer>

{% stylesheet %}
  .footer {
    border-top: 1px solid var(--color-border);
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
  }

  .footer__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .footer__top {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    padding-bottom: clamp(1.75rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .footer__brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 2rem;
  }

  .footer__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    color: var(--color-foreground-muted);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transition: color var(--duration) var(--ease-out);
  }

  a.footer__link:hover,
  a.footer__link:focus-visible {
    color: var(--color-accent);
  }

  .footer__link--muted {
    color: var(--color-foreground-muted);
  }

  .footer__copyright {
    color: var(--color-foreground-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  @media (min-width: 900px) {
    .footer__top {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 3rem;
    }

    .footer__nav {
      justify-content: flex-end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__link {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_label",
      "label": "t:labels.wordmark",
      "default": "KOVA"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "info": "t:info.footer_menu"
    },
    {
      "type": "header",
      "content": "t:general.fallback_navigation"
    },
    {
      "type": "text",
      "id": "link_1_label",
      "label": "t:labels.link_1_label",
      "default": "DROP"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "t:labels.link_1_url"
    },
    {
      "type": "text",
      "id": "link_2_label",
      "label": "t:labels.link_2_label"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "t:labels.link_2_url"
    },
    {
      "type": "text",
      "id": "link_3_label",
      "label": "t:labels.link_3_label",
      "default": "BUILD"
    },
    {
      "type": "url",
      "id": "link_3_url",
      "label": "t:labels.link_3_url"
    },
    {
      "type": "text",
      "id": "link_4_label",
      "label": "t:labels.link_4_label",
      "default": "MANIFESTO"
    },
    {
      "type": "url",
      "id": "link_4_url",
      "label": "t:labels.link_4_url"
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "t:labels.instagram_label",
      "default": "INSTAGRAM"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "t:labels.instagram_url"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "t:labels.copyright_text",
      "default": "KOVA"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": false
    }
  ]
}
{% endschema %}
