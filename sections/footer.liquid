<footer class="footer full-width">
  <div class="footer__inner">
    <a class="footer__brand" href="{{ routes.root_url }}">
      {{ section.settings.brand_label | escape }}
    </a>

    <nav class="footer__nav" aria-label="{{ 'accessibility.footer_navigation' | t }}">
      {% if section.settings.menu != blank and section.settings.menu.links.size > 0 %}
        {% for link in section.settings.menu.links %}
          <a class="footer__link" href="{{ link.url }}">{{ link.title | escape }}</a>
        {% endfor %}
      {% else %}
        {% if section.settings.link_1_label != blank %}
          <a class="footer__link" href="{{ section.settings.link_1_url | default: '#drop' }}">
            {{ section.settings.link_1_label | escape }}
          </a>
        {% endif %}
        {% if section.settings.link_2_label != blank and section.settings.link_2_url != blank %}
          <a class="footer__link" href="{{ section.settings.link_2_url }}">
            {{ section.settings.link_2_label | escape }}
          </a>
        {% endif %}
        {% if section.settings.link_3_label != blank %}
          <a class="footer__link" href="{{ section.settings.link_3_url | default: '/pages/build' }}">
            {{ section.settings.link_3_label | escape }}
          </a>
        {% endif %}
        {% if section.settings.link_4_label != blank %}
          <a class="footer__link" href="{{ section.settings.link_4_url | default: '/pages/manifesto' }}">
            {{ section.settings.link_4_label | escape }}
          </a>
        {% endif %}
      {% endif %}

      {% if section.settings.instagram_url != blank %}
        <a
          class="footer__link"
          href="{{ section.settings.instagram_url }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          {{ section.settings.instagram_label | escape }}
        </a>
      {% elsif section.settings.instagram_label != blank %}
        <span class="footer__link footer__link--muted">{{ section.settings.instagram_label | escape }}</span>
      {% endif %}
    </nav>

    <p class="footer__copyright">
      &copy; {{ 'now' | date: '%Y' }}
      {{ section.settings.copyright_text | default: shop.name | escape }}
    </p>
  </div>
</footer>

{% stylesheet %}
  .footer {
    border-top: 1px solid var(--color-border);
    padding-block: 3rem 2.5rem;
  }

  .footer__inner {
    display: grid;
    gap: 2rem;
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .footer__brand {
    justify-self: start;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.75rem;
  }

  .footer__link {
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer__link--muted {
    color: var(--color-foreground-muted);
  }

  .footer__copyright {
    color: var(--color-foreground-muted);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  @media (min-width: 900px) {
    .footer__inner {
      grid-template-columns: auto 1fr auto;
      align-items: end;
    }

    .footer__nav {
      justify-content: center;
    }

    .footer__copyright {
      justify-self: end;
      text-align: right;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_label",
      "label": "t:labels.wordmark",
      "default": "KOVA"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "info": "t:info.footer_menu"
    },
    {
      "type": "header",
      "content": "t:general.fallback_navigation"
    },
    {
      "type": "text",
      "id": "link_1_label",
      "label": "t:labels.link_1_label",
      "default": "DROP"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "t:labels.link_1_url"
    },
    {
      "type": "text",
      "id": "link_2_label",
      "label": "t:labels.link_2_label"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "t:labels.link_2_url"
    },
    {
      "type": "text",
      "id": "link_3_label",
      "label": "t:labels.link_3_label",
      "default": "BUILD"
    },
    {
      "type": "url",
      "id": "link_3_url",
      "label": "t:labels.link_3_url"
    },
    {
      "type": "text",
      "id": "link_4_label",
      "label": "t:labels.link_4_label",
      "default": "MANIFESTO"
    },
    {
      "type": "url",
      "id": "link_4_url",
      "label": "t:labels.link_4_url"
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "t:labels.instagram_label",
      "default": "INSTAGRAM"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "t:labels.instagram_url"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "t:labels.copyright_text",
      "default": "KOVA"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": false
    }
  ]
}
{% endschema %}
