<a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

<header class="header full-width">
  <div class="header__inner">
    <a class="header__wordmark" href="{{ routes.root_url }}">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 480
          | image_tag:
            class: 'header__logo',
            alt: shop.name,
            widths: '160, 240, 320, 480',
            sizes: '(max-width: 1099px) 140px, 184px'
        }}
      {% else %}
        <img
          class="header__logo"
          src="{{ 'kova-logo.png' | asset_url }}"
          alt="{{ shop.name | escape }}"
          width="240"
          height="92"
        >
      {% endif %}
    </a>

    <nav class="header__nav header__nav--desktop" aria-label="{{ 'accessibility.main_navigation' | t }}">
      {% render 'header-nav-links', section: section %}
    </nav>

    <div class="header__actions">
      <a class="header__cart" href="{{ routes.cart_url }}">
        <span>{{ section.settings.cart_label | escape }} ({{ cart.item_count }})</span>
        <span class="visually-hidden">{{ 'accessibility.cart_count' | t: count: cart.item_count }}</span>
      </a>

      <details class="header__menu-drawer">
        <summary class="header__menu-toggle">
          <span class="header__menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="visually-hidden header__menu-toggle-label header__menu-toggle-label--open">
            {{ section.settings.menu_label | escape }}
          </span>
          <span class="visually-hidden header__menu-toggle-label header__menu-toggle-label--close">
            {{ section.settings.menu_close_label | escape }}
          </span>
        </summary>

        <nav class="header__nav header__nav--mobile" aria-label="{{ 'accessibility.mobile_navigation' | t }}">
          {% render 'header-nav-links', section: section %}
          <a class="header__mobile-cart" href="{{ routes.cart_url }}">
            <span>{{ section.settings.cart_label | escape }} ({{ cart.item_count }})</span>
            <span class="visually-hidden">{{ 'accessibility.cart_count' | t: count: cart.item_count }}</span>
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

{% stylesheet %}
  .section-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header {
    position: relative;
    min-height: var(--header-height);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-height);
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .header__wordmark {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    min-height: 2.75rem;
    text-decoration: none;
    color: var(--color-foreground);
    line-height: 1;
  }

  .header__logo {
    display: block;
    width: auto;
    height: 2.45rem;
    max-width: min(11.5rem, 42vw);
    object-fit: contain;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.4vw, 2.75rem);
  }

  .header__nav--desktop {
    justify-content: center;
  }

  .header__nav-link,
  .header__cart,
  .header__mobile-cart,
  .header__menu-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.35rem 0;
    border: 0;
    background: transparent;
    color: var(--color-foreground-muted);
    text-decoration: none;
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--duration) var(--ease-out);
  }

  .header__cart,
  .header__menu-toggle {
    color: var(--color-foreground);
  }

  .header__nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.35rem;
    height: 1px;
    background: var(--color-foreground);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--duration) var(--ease-out);
  }

  .header__nav-link:hover,
  .header__nav-link:focus-visible,
  .header__cart:hover,
  .header__cart:focus-visible,
  .header__menu-toggle:hover,
  .header__menu-toggle:focus-visible {
    color: var(--color-foreground);
  }

  .header__nav-link:hover::after,
  .header__nav-link:focus-visible::after,
  .header__nav-link--current::after {
    transform: scaleX(1);
  }

  .header__nav-link--current {
    color: var(--color-foreground);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    justify-self: end;
  }

  .header__menu-icon {
    display: grid;
    gap: 5px;
    width: 1.35rem;
  }

  .header__menu-icon span {
    display: block;
    height: 1px;
    background: currentcolor;
  }

  .header__menu-drawer[open] .header__menu-icon span:nth-child(2) {
    opacity: 0;
  }

  .header__menu-drawer {
    display: none;
    position: static;
  }

  .header__menu-drawer > summary {
    list-style: none;
  }

  .header__menu-drawer > summary::-webkit-details-marker {
    display: none;
  }

  .header__menu-toggle-label--close {
    display: none;
  }

  .header__menu-drawer[open] .header__menu-toggle-label--open {
    display: none;
  }

  .header__menu-drawer[open] .header__menu-toggle-label--close {
    display: inline;
  }

  .header__nav--mobile {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 0.5rem var(--page-margin) 1.5rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .header__nav--mobile .header__nav-link,
  .header__mobile-cart {
    width: 100%;
    justify-content: space-between;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .header__nav--mobile .header__nav-link::after {
    left: 0;
    right: auto;
    width: 1.75rem;
    bottom: -1px;
  }

  .header__mobile-cart {
    border-bottom: 0;
    color: var(--color-foreground);
  }

  @media (max-width: 1099px) {
    .header__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.75rem;
    }

    .header__logo {
      height: 1.9rem;
      max-width: min(8.75rem, 52vw);
    }

    .header__nav--desktop,
    .header__cart {
      display: none;
    }

    .header__menu-drawer {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skip-link,
    .header__nav-link,
    .header__nav-link::after,
    .header__cart,
    .header__menu-toggle {
      transition: none;
    }
  }
{% endstylesheet %}

