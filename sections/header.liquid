<a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

<header class="header full-width">
  <div class="header__inner">
    <a class="header__wordmark" href="{{ routes.root_url }}">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 240
          | image_tag:
            class: 'header__logo',
            alt: shop.name,
            widths: '120, 180, 240',
            sizes: '120px'
        }}
      {% else %}
        <span class="header__wordmark-text">{{ section.settings.wordmark | escape }}</span>
      {% endif %}
    </a>

    <nav class="header__nav header__nav--desktop" aria-label="{{ 'accessibility.main_navigation' | t }}">
      {% render 'header-nav-links', section: section %}
    </nav>

    <div class="header__actions">
      <a class="header__cart" href="{{ routes.cart_url }}">
        <span>{{ section.settings.cart_label | escape }}</span>
        {% if cart.item_count > 0 %}
          <sup aria-hidden="true">{{ cart.item_count }}</sup>
          <span class="visually-hidden">{{ 'accessibility.cart_count' | t: count: cart.item_count }}</span>
        {% endif %}
      </a>

      <details class="header__menu-drawer">
        <summary class="header__menu-toggle">
          <span class="header__menu-toggle-label header__menu-toggle-label--open">
            {{ section.settings.menu_label | escape }}
          </span>
          <span class="header__menu-toggle-label header__menu-toggle-label--close">
            {{ section.settings.menu_close_label | escape }}
          </span>
        </summary>

        <nav class="header__nav header__nav--mobile" aria-label="{{ 'accessibility.mobile_navigation' | t }}">
          {% render 'header-nav-links', section: section %}
          <a class="header__mobile-cart" href="{{ routes.cart_url }}">
            {{ section.settings.cart_label | escape }}
            {% if cart.item_count > 0 %}
              <sup>{{ cart.item_count }}</sup>
            {% endif %}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

{% stylesheet %}
  .section-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header {
    position: relative;
    min-height: var(--header-height);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-height);
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .header__wordmark {
    text-decoration: none;
    color: var(--color-foreground);
    line-height: 1;
  }

  .header__wordmark-text {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .header__logo {
    display: block;
    width: auto;
    height: 1.25rem;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .header__nav--desktop {
    justify-content: center;
  }

  .header__nav-link,
  .header__cart,
  .header__mobile-cart,
  .header__menu-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.35rem 0;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .header__nav-link:hover,
  .header__nav-link:focus-visible,
  .header__cart:hover,
  .header__cart:focus-visible,
  .header__menu-toggle:hover,
  .header__menu-toggle:focus-visible {
    opacity: 0.55;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-self: end;
  }

  .header__cart sup,
  .header__mobile-cart sup {
    font-size: 0.65rem;
    letter-spacing: 0;
  }

  .header__menu-drawer {
    display: none;
    position: static;
  }

  .header__menu-drawer > summary {
    list-style: none;
  }

  .header__menu-drawer > summary::-webkit-details-marker {
    display: none;
  }

  .header__menu-toggle-label--close {
    display: none;
  }

  .header__menu-drawer[open] .header__menu-toggle-label--open {
    display: none;
  }

  .header__menu-drawer[open] .header__menu-toggle-label--close {
    display: inline;
  }

  .header__nav--mobile {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    padding: 1.25rem var(--page-margin) 1.75rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .header__nav--mobile .header__nav-link,
  .header__mobile-cart {
    width: 100%;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.85rem;
  }

  @media (max-width: 899px) {
    .header__inner {
      grid-template-columns: 1fr auto;
    }

    .header__nav--desktop,
    .header__cart {
      display: none;
    }

    .header__menu-drawer {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
{% endstylesheet %}

