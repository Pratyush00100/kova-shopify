<section
  class="hero full-width"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id | handle }}"
  {% endif %}
>
  <div
    class="hero__media{% if section.settings.image == blank %} hero__media--placeholder{% endif %}"
    aria-hidden="true"
  >
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'hero__image',
          widths: '750, 1100, 1500, 1800, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {% elsif section.settings.placeholder_label != blank %}
      <span class="hero__placeholder-label">{{ section.settings.placeholder_label | escape }}</span>
    {% endif %}
  </div>

  <div class="hero__content">
    <div class="hero__copy">
      {% if section.settings.heading != blank %}
        <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="hero__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          class="hero__cta"
          href="{{ section.settings.button_link | default: '#drop' }}"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>

    <p class="hero__brand" aria-hidden="true">{{ section.settings.brand_text | escape }}</p>
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - var(--header-height));
    display: grid;
    align-items: stretch;
    overflow: hidden;
    background: #000;
    color: #fff;
  }

  @supports (height: 100dvh) {
    .hero {
      min-height: calc(100dvh - var(--header-height));
    }
  }

  .hero__media,
  .hero__content {
    grid-area: 1 / 1;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #000;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.42;
    mix-blend-mode: lighten;
  }

  .hero__placeholder-label {
    position: absolute;
    right: var(--page-margin);
    bottom: 42%;
    color: rgb(255 255 255 / 22%);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(2rem, 8vh, 5rem);
    width: 100%;
    max-width: var(--page-width);
    min-height: inherit;
    margin-inline: auto;
    padding:
      clamp(1.25rem, 4vh, 2.75rem)
      var(--page-margin)
      clamp(0.35rem, 1.8vh, 1rem);
  }

  .hero__copy {
    display: grid;
    gap: 0.85rem;
    max-width: 22rem;
  }

  .hero__heading {
    margin: 0;
    font-size: clamp(0.92rem, 1.6vw, 1.15rem);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .hero__subheading {
    margin: 0;
    color: rgb(255 255 255 / 62%);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero__cta {
    justify-self: start;
    margin-top: 0.55rem;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    text-decoration: none;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    box-shadow: inset 0 -1px 0 rgb(255 255 255 / 70%);
  }

  .hero__cta:hover,
  .hero__cta:focus-visible {
    color: rgb(255 255 255 / 70%);
  }

  .hero__brand {
    margin: 0;
    max-width: 100%;
    font-size: clamp(4.5rem, 19vw, 15rem);
    font-weight: 700;
    line-height: 0.76;
    letter-spacing: -0.055em;
    text-transform: uppercase;
    user-select: none;
  }

  @media (max-width: 749px) {
    .hero__copy {
      max-width: 16rem;
    }

    .hero__brand {
      font-size: clamp(3.75rem, 26vw, 7.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cta {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "tag": "div",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:labels.anchor_id",
      "default": "top"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "t:labels.brand_text",
      "default": "KOVA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "DROP 001 // VELOCITY"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "LIVE NOW"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "EXPLORE DROP 001"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.hero_image",
      "info": "t:info.hero_image"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "t:labels.placeholder_label",
      "default": "Image forthcoming"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
