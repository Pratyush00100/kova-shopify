{% liquid
  assign has_desktop_image = false
  assign has_mobile_image = false
  if section.settings.image != blank
    assign has_desktop_image = true
  endif
  if section.settings.image_mobile != blank
    assign has_mobile_image = true
  endif

  assign has_image = false
  if has_desktop_image or has_mobile_image
    assign has_image = true
  endif
%}

<section
  class="hero full-width{% if has_image %} hero--media{% endif %}"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id | handle }}"
  {% endif %}
>
  <div class="hero__media">
    {% if has_image %}
      {% if has_desktop_image and has_mobile_image %}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.image_mobile | image_url: width: 750 }} 750w,
              {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w,
              {{ section.settings.image_mobile | image_url: width: 1400 }} 1400w
            "
            sizes="100vw"
          >
          {{
            section.settings.image
            | image_url: width: 3200
            | image_tag:
              class: 'hero__image',
              widths: '750, 1100, 1400, 1800, 2400, 3200',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high'
          }}
        </picture>
      {% elsif has_desktop_image %}
        {{
          section.settings.image
          | image_url: width: 3200
          | image_tag:
            class: 'hero__image',
            widths: '750, 1100, 1400, 1800, 2400, 3200',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {% else %}
        {{
          section.settings.image_mobile
          | image_url: width: 1800
          | image_tag:
            class: 'hero__image',
            widths: '480, 750, 1100, 1400, 1800',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {% endif %}
    {% else %}
      <div class="hero__placeholder" aria-hidden="true"></div>
    {% endif %}

    {% if section.settings.badge_image != blank %}
      <div class="hero__badge">
        {{
          section.settings.badge_image
          | image_url: width: 280
          | image_tag:
            class: 'hero__badge-image',
            widths: '120, 180, 240, 280',
            sizes: '120px',
            loading: 'eager',
            alt: ''
        }}
      </div>
    {% endif %}
  </div>

  <div class="hero__inner">
    <div class="hero__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="hero__body">{{ section.settings.body }}</div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          class="btn btn--arrow hero__cta"
          href="{{ section.settings.button_link | default: '/collections/drop-001' }}"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: calc(100svh - var(--header-height));
    border-bottom: 1px solid var(--color-border);
  }

  @supports (height: 100dvh) {
    .hero {
      min-height: calc(100dvh - var(--header-height));
    }
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--color-background);
  }

  .hero--media .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgb(0 0 0 / 62%) 0%,
      rgb(0 0 0 / 28%) 34%,
      rgb(0 0 0 / 8%) 62%,
      rgb(0 0 0 / 0%) 100%
    );
  }

  .hero__media picture,
  .hero__image,
  .hero__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .hero__media picture {
    position: absolute;
    inset: 0;
  }

  .hero__image,
  .hero__media picture img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  .hero__placeholder {
    min-height: 100%;
    background:
      linear-gradient(180deg, transparent 0%, rgb(0 0 0 / 55%) 100%),
      repeating-linear-gradient(
        -18deg,
        var(--color-surface) 0 1px,
        transparent 1px 18px
      );
  }

  .hero__badge {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 1;
    width: min(7.5rem, 28vw);
    pointer-events: none;
  }

  .hero__badge-image {
    width: 100%;
    height: auto;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: center;
    width: 100%;
    max-width: var(--page-width);
    min-height: inherit;
    margin-inline: auto;
  }

  .hero__copy {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.25rem;
    padding: clamp(2.5rem, 8vw, 5rem) var(--page-margin);
  }

  .hero__heading {
    margin: 0;
    max-width: 11ch;
    font-family: var(--font-display--family);
    font-style: var(--font-display--style);
    font-weight: var(--font-display--weight);
    font-size: clamp(3rem, 8.5vw, 6.75rem);
    line-height: 0.86;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hero__body {
    max-width: 36ch;
    color: var(--color-foreground-muted);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .hero__body p {
    margin: 0;
  }

  .hero__cta {
    margin-top: 0.5rem;
  }

  @media (max-width: 749px) {
    .hero--media .hero__media::after {
      background: linear-gradient(
        180deg,
        rgb(0 0 0 / 58%) 0%,
        rgb(0 0 0 / 28%) 48%,
        rgb(0 0 0 / 12%) 100%
      );
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "tag": "div",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:labels.anchor_id",
      "default": "top"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "KOVA // METAL ART"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "METAL, REIMAGINED."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.description",
      "default": "<p>Metal art for your space. Designed to stand out.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "EXPLORE COLLECTIONS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.hero_image",
      "info": "t:info.hero_image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:labels.hero_image_mobile",
      "info": "t:info.hero_image_mobile"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "t:labels.badge_image",
      "info": "t:info.badge_image"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
