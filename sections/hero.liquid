{% liquid
  assign has_desktop_image = false
  assign has_mobile_image = false
  if section.settings.image != blank
    assign has_desktop_image = true
  endif
  if section.settings.image_mobile != blank
    assign has_mobile_image = true
  endif

  assign has_image = false
  if has_desktop_image or has_mobile_image
    assign has_image = true
  endif
%}

<section
  class="hero full-width{% if has_image %} hero--media{% endif %}"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id | handle }}"
  {% endif %}
>
  <div class="hero__inner">
    <div class="hero__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="hero__body">{{ section.settings.body }}</div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          class="btn btn--arrow hero__cta"
          href="{{ section.settings.button_link | default: '/collections/drop-001' }}"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>

    <div class="hero__media">
      {% if has_image %}
        {% if has_desktop_image and has_mobile_image %}
          <picture>
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}"
            >
            {{
              section.settings.image
              | image_url: width: 1800
              | image_tag:
                class: 'hero__image',
                widths: '750, 1100, 1400, 1800',
                sizes: '(min-width: 900px) 52vw, 100vw',
                loading: 'eager',
                fetchpriority: 'high'
            }}
          </picture>
        {% elsif has_desktop_image %}
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              class: 'hero__image',
              widths: '750, 1100, 1400, 1800',
              sizes: '(min-width: 900px) 52vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {% else %}
          {{
            section.settings.image_mobile
            | image_url: width: 1200
            | image_tag:
              class: 'hero__image',
              widths: '480, 750, 1100, 1200',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {% endif %}
      {% else %}
        <div class="hero__placeholder" aria-hidden="true"></div>
      {% endif %}

      {% if section.settings.badge_image != blank %}
        <div class="hero__badge">
          {{
            section.settings.badge_image
            | image_url: width: 280
            | image_tag:
              class: 'hero__badge-image',
              widths: '120, 180, 240, 280',
              sizes: '120px',
              loading: 'eager',
              alt: ''
          }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero {
    border-bottom: 1px solid var(--color-border);
  }

  .hero__inner {
    display: grid;
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    min-height: calc(100svh - var(--header-height));
  }

  @supports (height: 100dvh) {
    .hero__inner {
      min-height: calc(100dvh - var(--header-height));
    }
  }

  .hero__copy {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.25rem;
    padding: clamp(2.5rem, 8vw, 5rem) var(--page-margin);
  }

  .hero__heading {
    margin: 0;
    max-width: 11ch;
    font-family: var(--font-display--family);
    font-style: var(--font-display--style);
    font-weight: var(--font-display--weight);
    font-size: clamp(3rem, 8.5vw, 6.75rem);
    line-height: 0.86;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hero__body {
    max-width: 36ch;
    color: var(--color-foreground-muted);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .hero__body p {
    margin: 0;
  }

  .hero__cta {
    margin-top: 0.5rem;
  }

  .hero__media {
    position: relative;
    min-height: 22rem;
    overflow: hidden;
    background: var(--color-surface);
  }

  .hero__media picture,
  .hero__image,
  .hero__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__media picture {
    height: 100%;
  }

  .hero__media picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__placeholder {
    min-height: inherit;
    background:
      linear-gradient(180deg, transparent 0%, rgb(0 0 0 / 55%) 100%),
      repeating-linear-gradient(
        -18deg,
        var(--color-surface) 0 1px,
        transparent 1px 18px
      );
  }

  .hero__badge {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: min(7.5rem, 28vw);
    pointer-events: none;
  }

  .hero__badge-image {
    width: 100%;
    height: auto;
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(18rem, 0.92fr) minmax(0, 1.08fr);
    }

    .hero__media,
    .hero__placeholder {
      min-height: 100%;
    }

    .hero__copy {
      padding-inline-end: clamp(1.5rem, 4vw, 3.5rem);
    }
  }

  @media (max-width: 899px) {
    .hero__inner {
      min-height: 0;
    }

    .hero__media {
      min-height: min(70vw, 28rem);
      aspect-ratio: 4 / 5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "tag": "div",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:labels.anchor_id",
      "default": "top"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "KOVA // METAL ART"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "METAL, REIMAGINED."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.description",
      "default": "<p>Metal art for your space. Designed to stand out.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "EXPLORE COLLECTIONS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.hero_image",
      "info": "t:info.hero_image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:labels.hero_image_mobile",
      "info": "t:info.hero_image_mobile"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "t:labels.badge_image",
      "info": "t:info.badge_image"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
