{% comment %}
  Homepage hero. A predominantly black field with the drop identity set small
  at the top and the KOVA wordmark anchored low in the viewport.

  The image is optional on purpose: final photography is not available yet, so
  the composition has to read as intentional while empty. When an image is
  assigned it is masked and blended into the black field so it never reads as a
  rectangular image card.
{% endcomment %}

{% liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
%}

<section
  class="hero full-width{% unless has_image %} hero--unillustrated{% endunless %}"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id | handle }}"
  {% endif %}
>
  {% if has_image %}
    <div class="hero__media" aria-hidden="true">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'hero__image',
          widths: '750, 1100, 1500, 1800, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    </div>
  {% endif %}

  <div class="hero__content">
    <div class="hero__meta">
      <div class="hero__identity">
        {% if section.settings.heading != blank %}
          <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p class="hero__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>

      {% if has_image == false and section.settings.placeholder_label != blank %}
        <p class="hero__note">{{ section.settings.placeholder_label | escape }}</p>
      {% endif %}
    </div>

    <div class="hero__foot">
      <p class="hero__brand" aria-hidden="true">{{ section.settings.brand_text | escape }}</p>

      {% if section.settings.button_label != blank %}
        <a class="hero__cta" href="{{ section.settings.button_link | default: '/collections/drop-001' }}">
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: calc(100svh - var(--header-height));
    overflow: hidden;
    background: #000;
    color: #fff;
  }

  @supports (height: 100dvh) {
    .hero {
      min-height: calc(100dvh - var(--header-height));
    }
  }

  .hero__media,
  .hero__content {
    grid-area: 1 / 1;
  }

  .hero__media {
    position: relative;
    z-index: 0;
  }

  /* Masked and lightened so the photograph dissolves into the black field
     instead of sitting on it as a rectangle. */
  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 42%;
    opacity: 0.52;
    mix-blend-mode: lighten;
    -webkit-mask-image: radial-gradient(105% 82% at 66% 38%, #000 0%, #000 32%, rgb(0 0 0 / 45%) 62%, transparent 84%);
    mask-image: radial-gradient(105% 82% at 66% 38%, #000 0%, #000 32%, rgb(0 0 0 / 45%) 62%, transparent 84%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(3rem, 12vh, 7rem);
    width: 100%;
    max-width: var(--page-width);
    min-height: inherit;
    margin-inline: auto;
    padding: clamp(1.75rem, 6vh, 3.25rem) var(--page-margin) clamp(1.1rem, 3.5vh, 2.25rem);
  }

  .hero__meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .hero__identity {
    display: grid;
    gap: 0.6rem;
  }

  .hero__heading {
    margin: 0;
    font-size: clamp(0.8rem, 1vw, 1rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .hero__subheading {
    margin: 0;
    color: rgb(255 255 255 / 55%);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  /* Honest note about missing photography. Kept quiet so the empty hero still
     reads as a finished composition. */
  .hero__note {
    margin: 0;
    color: rgb(255 255 255 / 24%);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-align: right;
  }

  .hero__foot {
    display: grid;
    gap: clamp(1.25rem, 3vh, 2rem);
  }

  .hero__brand {
    margin: 0;
    /* Negative inline start pulls the glyph edge onto the page margin so the
       wordmark aligns optically rather than mathematically. */
    margin-inline-start: -0.045em;
    font-size: min(20vw, 15.5rem);
    font-weight: 700;
    line-height: 0.74;
    letter-spacing: -0.055em;
    text-transform: uppercase;
    user-select: none;
  }

  .hero__cta {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-block: 0.35rem;
    color: #fff;
    text-decoration: none;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    box-shadow: inset 0 -1px 0 rgb(255 255 255 / 65%);
    transition: box-shadow 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }

  .hero__cta:hover,
  .hero__cta:focus-visible {
    color: rgb(255 255 255 / 72%);
    box-shadow: inset 0 -1px 0 rgb(255 255 255 / 30%);
  }

  /* The global focus ring is the foreground colour, which is invisible on the
     black hero field. */
  .hero__cta:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  .hero--unillustrated .hero__content {
    gap: clamp(4rem, 18vh, 9rem);
  }

  /* Tablet: the wordmark still leads, but the CTA stays under it so the
     baseline does not crowd at mid widths. */
  @media (min-width: 600px) {
    .hero__brand {
      font-size: min(21vw, 15.5rem);
    }
  }

  @media (min-width: 900px) {
    .hero__foot {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: clamp(2rem, 6vw, 6rem);
    }

    .hero__cta {
      margin-bottom: clamp(0.75rem, 1.6vh, 1.5rem);
    }
  }

  @media (max-width: 599px) {
    .hero__meta {
      flex-direction: column;
      gap: 0.85rem;
    }

    .hero__note {
      text-align: left;
    }

    .hero__brand {
      font-size: min(27vw, 9rem);
      letter-spacing: -0.05em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cta {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "tag": "div",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:labels.anchor_id",
      "default": "top"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "t:labels.brand_text",
      "default": "KOVA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "DROP 001 // VELOCITY"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "LIVE NOW"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "EXPLORE DROP 001"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.hero_image",
      "info": "t:info.hero_image"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "t:labels.placeholder_label",
      "info": "t:info.hero_placeholder_label",
      "default": "Image forthcoming"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
