{% comment %}
  Restrained Manifesto-only bridge to Drop 001. Does not render products,
  prices, inventory, or sales claims.
{% endcomment %}

{% liquid
  assign drop_collection = section.settings.collection
  assign drop_url = section.settings.button_link

  if drop_collection != blank
    assign drop_url = drop_collection.url
  endif

  if drop_url == blank
    assign drop_url = collections['drop-001'].url
  endif
%}

{% if section.settings.heading != blank or section.settings.button_label != blank %}
  <section class="manifesto-commerce full-width section-pad">
    <div class="manifesto-commerce__inner page-inner">
      {% if section.settings.heading != blank %}
        <h2 class="section-title manifesto-commerce__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.button_label != blank and drop_url != blank %}
        <a class="btn" href="{{ drop_url }}">{{ section.settings.button_label | escape }}</a>
      {% endif %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .manifesto-commerce {
    border-top: 1px solid var(--color-border);
  }

  .manifesto-commerce__inner {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  @media (min-width: 900px) {
    .manifesto-commerce__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.manifesto_commerce",
  "tag": "div",
  "class": "section-manifesto-commerce",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "DROP 001 // VELOCITY"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection",
      "info": "t:info.build_commerce_collection"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "EXPLORE DROP 001"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link",
      "info": "t:info.build_commerce_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.manifesto_commerce"
    }
  ]
}
{% endschema %}
