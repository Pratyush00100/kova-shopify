<section
  class="marquee full-width"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="marquee__viewport">
    <div class="marquee__track" {% if section.settings.reduce_motion %}data-static{% endif %}>
      {% for i in (1..4) %}
        <p class="marquee__content" {% if forloop.index > 1 %}aria-hidden="true"{% endif %}>
          {{ section.settings.text | escape }}
        </p>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .marquee {
    border-block: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
  }

  .marquee__viewport {
    overflow: hidden;
  }

  .marquee__track {
    display: flex;
    width: max-content;
    gap: 0;
    animation: marquee-scroll 36s linear infinite;
  }

  .marquee__track[data-static] {
    animation: none;
    width: 100%;
    justify-content: center;
  }

  .marquee__track[data-static] .marquee__content[aria-hidden='true'] {
    display: none;
  }

  .marquee__content {
    margin: 0;
    padding: 0.85rem 0;
    white-space: nowrap;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .marquee__content::after {
    content: '';
    display: inline-block;
    width: 4rem;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-25%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
      width: 100%;
      justify-content: center;
    }

    .marquee__content[aria-hidden='true'] {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.marquee",
  "tag": "div",
  "class": "section-marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.marquee_text",
      "default": "KOVA • DROP 001 • VELOCITY • LIMITED RUN • KOVA"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "t:labels.accessibility_label",
      "default": "Announcement"
    },
    {
      "type": "checkbox",
      "id": "reduce_motion",
      "label": "t:labels.reduce_motion",
      "default": false,
      "info": "t:info.reduce_motion"
    }
  ],
  "presets": [
    {
      "name": "t:general.marquee"
    }
  ]
}
{% endschema %}
