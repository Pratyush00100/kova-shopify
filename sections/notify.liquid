{% comment %}
  Drop notification signup. Uses Shopify's built-in customer form so no
  additional app or dependency is required.

  Also rendered on the Drop 001 template, so the presentation stays surface
  neutral.
{% endcomment %}

<section
  class="notify full-width"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id | handle }}"
  {% endif %}
>
  <div class="notify__inner page-inner">
    <div class="notify__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow notify__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="notify__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="rte notify__description">{{ section.settings.description }}</div>
      {% endif %}
    </div>

    <div class="notify__form-wrapper">
      {% form 'customer', class: 'notify__form' %}
        {% if form.posted_successfully? %}
          <p class="notify__message" role="status">{{ 'newsletter.success' | t }}</p>
        {% else %}
          <input type="hidden" name="contact[tags]" value="{{ section.settings.customer_tag | escape }}">

          <label class="visually-hidden" for="NotifyEmail-{{ section.id }}">
            {{ 'newsletter.email_label' | t }}
          </label>

          <div class="notify__field">
            <input
              id="NotifyEmail-{{ section.id }}"
              class="notify__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ 'newsletter.email_placeholder' | t }}"
              autocomplete="email"
              required
            >

            <button class="btn notify__submit" type="submit">
              {{ section.settings.button_label | escape }}
            </button>
          </div>

          {% if form.errors %}
            <p class="notify__message notify__message--error" role="alert">
              {{ form.errors.messages['email'] }}
            </p>
          {% endif %}
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

{% stylesheet %}
  .notify {
    padding-block: clamp(4rem, 10vw, 7.5rem);
    border-top: 1px solid var(--color-border);
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .notify__inner {
    display: grid;
    gap: clamp(2.25rem, 5vw, 4.5rem);
  }

  .notify__copy {
    display: grid;
    gap: 1rem;
    max-width: 38ch;
  }

  .notify__heading {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .notify__eyebrow,
  .notify__description {
    color: color-mix(in srgb, var(--color-background) 62%, transparent);
  }

  .notify__description {
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .notify__field {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem;
    max-width: 34rem;
  }

  /* Underlined rather than boxed, so the form reads as typography on the dark
     panel instead of a generic newsletter widget. */
  .notify__input {
    flex: 1 1 15rem;
    min-height: 3.25rem;
    padding: 0.75rem 0;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-background) 40%, transparent);
    background: transparent;
    color: var(--color-background);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    transition: border-color 0.3s var(--ease-out);
  }

  .notify__input:focus {
    outline: none;
    border-bottom-color: var(--color-background);
  }

  /* The global focus ring is the foreground colour, which is invisible on this
     inverted panel. */
  .notify__input:focus-visible,
  .notify__submit:focus-visible {
    outline: 2px solid var(--color-background);
    outline-offset: 4px;
  }

  .notify__input::placeholder {
    color: color-mix(in srgb, var(--color-background) 48%, transparent);
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
  }

  .notify__submit {
    flex: 0 0 auto;
    border-color: var(--color-background);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .notify__submit:hover,
  .notify__submit:focus-visible {
    background: transparent;
    color: var(--color-background);
  }

  .notify__message {
    margin: 1.25rem 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .notify__message--error {
    color: #ff8f7a;
  }

  @media (min-width: 900px) {
    .notify__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      column-gap: clamp(3rem, 8vw, 8rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notify__input {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.notify",
  "tag": "div",
  "class": "section-notify",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:labels.anchor_id",
      "default": "notify"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "NOTIFY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "BE FIRST ON DROP 002"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description",
      "default": "<p>Drops are small and they move fast. Get the release time before it goes public.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "NOTIFY ME"
    },
    {
      "type": "text",
      "id": "customer_tag",
      "label": "t:labels.customer_tag",
      "default": "drop-notify",
      "info": "t:info.customer_tag"
    }
  ],
  "presets": [
    {
      "name": "t:general.notify"
    }
  ]
}
{% endschema %}
