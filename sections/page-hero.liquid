{% comment %}
  Reusable editorial page header. Used by the BUILD and MANIFESTO pages, and
  available for any other page template. Falls back to the page title so the
  section stays useful when a merchant leaves the heading empty.
{% endcomment %}

{% liquid
  assign hero_heading = section.settings.heading
  if hero_heading == blank
    assign hero_heading = page.title
  endif

  assign has_background = false
  if section.settings.background_image != blank
    assign has_background = true
  endif

  assign hero_class = 'page-hero full-width'
  if has_background
    assign hero_class = hero_class | append: ' page-hero--media'
  endif
%}

<section class="{{ hero_class }}">
  {% if has_background %}
    <div class="page-hero__background" aria-hidden="true">
      {{
        section.settings.background_image
        | image_url: width: 3200
        | image_tag:
          class: 'page-hero__background-image',
          widths: '750, 1100, 1400, 1800, 2400, 3200',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
    </div>
  {% endif %}

  <div class="page-hero__inner page-inner">
    <div class="page-hero__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow eyebrow--marked">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if hero_heading != blank %}
        <h1 class="display-title">{{ hero_heading | escape }}</h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="rte page-hero__description">{{ section.settings.description }}</div>
      {% endif %}
    </div>

    {% if section.settings.show_image and section.settings.image != blank %}
      <div class="page-hero__media">
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            class: 'page-hero__image',
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 900px) 45vw, 100vw',
            loading: 'eager'
        }}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-section);
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero--media {
    display: flex;
    align-items: flex-end;
    min-height: min(28rem, 72svh);
  }

  .page-hero__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--color-background);
  }

  .page-hero--media .page-hero__background::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgb(0 0 0 / 72%) 0%,
      rgb(0 0 0 / 38%) 38%,
      rgb(0 0 0 / 12%) 68%,
      rgb(0 0 0 / 4%) 100%
    );
  }

  .page-hero__background-image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
    width: 100%;
  }

  .page-hero__copy {
    display: grid;
    gap: 1.1rem;
    max-width: 46ch;
  }

  .page-hero__description {
    font-size: var(--text-base);
  }

  .page-hero__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface);
  }

  .page-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .page-hero__inner:has(.page-hero__media) {
      grid-template-columns: 1fr 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page_hero",
  "tag": "div",
  "class": "section-page-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.heading_fallback"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.hero_image",
      "info": "t:info.hero_image"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:labels.show_image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.assigned_image_only"
    }
  ],
  "presets": [
    {
      "name": "t:general.page_hero"
    }
  ]
}
{% endschema %}
