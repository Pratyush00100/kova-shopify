{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us. BUILD and MANIFESTO use their own templates.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="full-width section-pad">
  <div class="page__inner page-inner">
    {% if section.settings.show_title %}
      <h1 class="display-title page__title">{{ page.title | escape }}</h1>
    {% endif %}

    {% if page.content != blank %}
      <div class="rte page__content">{{ page.content }}</div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .page__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .page__content {
    max-width: 70ch;
    font-size: 1rem;
  }

  .page__content :is(h2, h3, h4) {
    color: var(--color-foreground);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:labels.show_title",
      "default": true
    }
  ]
}
{% endschema %}
