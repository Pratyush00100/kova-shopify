<section class="process full-width section-pad">
  <div class="process__inner page-inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <header class="process__header">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow eyebrow--marked">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="section-title process__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ol class="process__list">
        {% for block in section.blocks %}
          <li class="process__step" {{ block.shopify_attributes }}>
            <p class="process__number" aria-hidden="true">
              {{ forloop.index | prepend: '0' | slice: -2, 2 }}
            </p>

            {% if block.settings.title != blank %}
              <h3 class="process__title">{{ block.settings.title | escape }}</h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="rte process__description">{{ block.settings.description }}</div>
            {% endif %}
          </li>
        {% endfor %}
      </ol>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .process__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .process__heading {
    margin-top: 0.6rem;
  }

  .process__list {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process__step {
    display: grid;
    gap: 0.85rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .process__number {
    margin: 0;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
  }

  .process__title {
    margin: 0;
    font-family: var(--font-display--family);
    font-size: var(--text-lg);
    font-weight: var(--font-display--weight);
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .process__description {
    font-size: var(--text-sm);
  }

  .process__step:hover {
    border-top-color: var(--color-foreground);
  }

  @media (min-width: 1100px) {
    .process__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.process_steps",
  "tag": "div",
  "class": "section-process",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "PROCESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "CAD TO PACKAGING"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:general.step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "CAD / DESIGN"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:labels.description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.process_steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "CAD / DESIGN"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "LASER CUTTING"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "FINISHING"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "INSPECTION"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "PACKAGING"
          }
        }
      ]
    }
  ]
}
{% endschema %}
