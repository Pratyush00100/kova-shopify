{% comment %}
  KOVA product page: primary conversion surface.
  Price, availability and edition labels come from Shopify variants.
  Spec rows render only when a value exists. Do not invent catalog facts.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign drop_collection = nil

  for collection in product.collections
    if collection.handle == 'drop-001'
      assign drop_collection = collection
      break
    endif
  endfor

  if drop_collection == blank
    for collection in product.collections
      unless collection.handle == 'all'
        assign drop_collection = collection
        break
      endunless
    endfor
  endif

  if drop_collection != blank
    assign drop_label = drop_collection.title
  else
    assign drop_label = section.settings.eyebrow
  endif

  assign has_details = false
  for block in section.blocks
    if block.settings.label != blank and block.settings.value != blank
      assign has_details = true
    endif
  endfor
%}

<div class="product full-width section-pad" data-product-root>
  <div class="product__inner page-inner">
    {% if drop_collection != blank %}
      <nav class="product__breadcrumb" aria-label="{{ 'accessibility.breadcrumb' | t }}">
        <a class="product__breadcrumb-link" href="{{ drop_collection.url }}">
          {{- drop_collection.title | escape -}}
        </a>
        <span class="product__breadcrumb-divider" aria-hidden="true">/</span>
        <span class="product__breadcrumb-current" aria-current="page">{{ product.title | escape }}</span>
      </nav>
    {% endif %}

    <div class="product__layout">
      <div class="product__gallery{% if product.images.size > 1 %} product__gallery--thumbs{% endif %}" data-product-gallery>
        {% if product.images.size > 0 %}
          <div class="product__stage">
            {% for image in product.images %}
              <figure
                class="product__stage-frame"
                data-gallery-slide
                data-image-id="{{ image.id }}"
                {% unless forloop.first %}
                  hidden
                {% endunless %}
              >
                {% if forloop.first %}
                  {{
                    image
                    | image_url: width: 1800
                    | image_tag:
                      class: 'product__image',
                      widths: '600, 800, 1000, 1200, 1500, 1800',
                      sizes: '(min-width: 900px) 48vw, 100vw',
                      loading: 'eager',
                      fetchpriority: 'high'
                  }}
                {% else %}
                  {{
                    image
                    | image_url: width: 1800
                    | image_tag:
                      class: 'product__image',
                      widths: '600, 800, 1000, 1200, 1500, 1800',
                      sizes: '(min-width: 900px) 48vw, 100vw',
                      loading: 'lazy'
                  }}
                {% endif %}
              </figure>
            {% endfor %}
          </div>

          {% if product.images.size > 1 %}
            <ul class="product__thumbs" role="list">
              {% for image in product.images %}
                <li class="product__thumb-item">
                  <button
                    class="product__thumb"
                    type="button"
                    data-gallery-thumb
                    data-image-id="{{ image.id }}"
                    aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                    aria-label="{{ 'products.view_image' | t: index: forloop.index, count: product.images.size }}"
                  >
                    {{
                      image
                      | image_url: width: 240
                      | image_tag:
                        class: 'product__thumb-image',
                        widths: '120, 180, 240',
                        sizes: '72px',
                        loading: 'lazy',
                        alt: ''
                    }}
                  </button>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        {% else %}
          <div class="product__stage">
            <div class="product__stage-frame product__stage-frame--placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'media-placeholder product__placeholder' }}
            </div>
          </div>
        {% endif %}
      </div>

      <div class="product__info">
        <div class="product__info-sticky" data-product-purchase>
          <div class="product__identity">
            {% if drop_label != blank %}
              <p class="eyebrow product__drop">{{ drop_label | escape }}</p>
            {% endif %}

            <h1 class="product__title">{{ product.title | escape }}</h1>

            <p class="product__price" aria-live="polite">
              <span
                class="visually-hidden"
                data-product-sale-label
                {% unless current_variant.compare_at_price > current_variant.price %}
                  hidden
                {% endunless %}
              >
                {{ 'products.sale_price' | t }}
              </span>
              <span class="product__price-current" data-product-price>{{ current_variant.price | money }}</span>
              <s
                class="product__price-compare"
                data-product-compare
                {% unless current_variant.compare_at_price > current_variant.price %}
                  hidden
                {% endunless %}
              >
                {{ current_variant.compare_at_price | money }}
              </s>
            </p>
          </div>

          {% form 'product', product, class: 'product__form' %}
            {% if product.variants.size > 1 %}
              <fieldset class="product__variants">
                <legend class="product__label product__variants-legend">
                  {{- product.options | join: ' / ' | escape -}}
                </legend>

                <div class="product__variant-grid">
                  {% for variant in product.variants %}
                    <div class="product__variant">
                      <input
                        id="ProductVariant-{{ section.id }}-{{ variant.id }}"
                        class="product__variant-input"
                        type="radio"
                        name="id"
                        value="{{ variant.id }}"
                        data-product-variant
                        data-available="{% if variant.available %}true{% else %}false{% endif %}"
                        data-price="{{ variant.price | money | escape }}"
                        data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                        {% if variant.image %}
                          data-image-id="{{ variant.image.id }}"
                        {% endif %}
                        {% if variant == current_variant %}
                          checked
                        {% endif %}
                      >

                      <label
                        class="product__variant-label"
                        for="ProductVariant-{{ section.id }}-{{ variant.id }}"
                      >
                        <span class="product__variant-title">{{ variant.title | escape }}</span>

                        {% if product.price_varies %}
                          <span class="product__variant-meta">{{ variant.price | money }}</span>
                        {% endif %}

                        {% unless variant.available %}
                          <span class="product__variant-meta product__variant-meta--sold">
                            {{- 'products.sold_out' | t -}}
                          </span>
                        {% endunless %}
                      </label>
                    </div>
                  {% endfor %}
                </div>
              </fieldset>
            {% else %}
              <input type="hidden" name="id" value="{{ current_variant.id }}">
            {% endif %}

            <div class="product__field product__field--quantity">
              <label class="product__label" for="ProductQuantity-{{ section.id }}">
                {{ 'products.quantity' | t }}
              </label>

              <div class="product__quantity-control">
                <button
                  class="product__quantity-step"
                  type="button"
                  data-quantity-step="-1"
                  aria-label="{{ 'products.quantity_decrease' | t | escape }}"
                >
                  &minus;
                </button>

                <input
                  id="ProductQuantity-{{ section.id }}"
                  class="product__quantity"
                  type="number"
                  name="quantity"
                  value="1"
                  min="1"
                  step="1"
                  inputmode="numeric"
                  data-quantity-input
                >

                <button
                  class="product__quantity-step"
                  type="button"
                  data-quantity-step="1"
                  aria-label="{{ 'products.quantity_increase' | t | escape }}"
                >
                  +
                </button>
              </div>
            </div>

            <button
              class="btn product__submit"
              type="submit"
              name="add"
              data-product-submit
              data-add-label="{{ 'products.add_to_cart' | t | escape }}"
              data-sold-label="{{ 'products.sold_out' | t | escape }}"
              {% unless current_variant.available %}
                disabled
              {% endunless %}
            >
              {% if current_variant.available %}
                {{ 'products.add_to_cart' | t }}
              {% else %}
                {{ 'products.sold_out' | t }}
              {% endif %}
            </button>
          {% endform %}

          {% liquid
            assign assurances = ''
            assign assurances = section.settings.assurance_1 | append: '||' | append: section.settings.assurance_2 | append: '||' | append: section.settings.assurance_3 | append: '||' | append: section.settings.assurance_4
            assign assurance_list = assurances | split: '||'
            assign has_assurances = false
            for entry in assurance_list
              if entry != blank
                assign has_assurances = true
              endif
            endfor
          %}

          {% if has_assurances %}
            <ul class="product__trust" role="list">
              {% for entry in assurance_list %}
                {% if entry != blank %}
                  <li class="product__trust-item">{{ entry | escape }}</li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}

          {% if section.settings.custom_label != blank and section.settings.whatsapp_number != blank %}
            {% liquid
              assign wa_number = section.settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-'
              capture wa_message
                echo section.settings.custom_message
                echo ' '
                echo product.title
              endcapture
              assign wa_text = wa_message | strip | url_param_escape
              assign wa_href = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
            %}

            <div class="product__custom">
              {% if section.settings.custom_heading != blank %}
                <p class="product__custom-heading">{{ section.settings.custom_heading | escape }}</p>
              {% endif %}

              {% if section.settings.custom_text != blank %}
                <p class="product__custom-text">{{ section.settings.custom_text | escape }}</p>
              {% endif %}

              <a
                class="btn btn--ghost product__custom-cta"
                href="{{ wa_href }}"
                target="_blank"
                rel="noopener noreferrer"
              >
                {{ section.settings.custom_label | escape }}
              </a>
            </div>
          {% endif %}

          {% liquid
            assign show_materials = false
            if product.description != blank or has_details
              assign show_materials = true
            endif
            assign show_shipping = false
            if section.settings.shipping_content != blank
              assign show_shipping = true
            endif
            assign show_warranty = false
            if section.settings.warranty_content != blank
              assign show_warranty = true
            endif
          %}

          {% if show_materials or show_shipping or show_warranty %}
            <div class="product__accordions">
              {% if show_materials %}
                <details class="product__accordion" open>
                  <summary class="product__accordion-summary">
                    {{ section.settings.materials_heading | default: 'Materials & Specs' | escape }}
                  </summary>
                  <div class="product__accordion-body">
                    {% if product.description != blank %}
                      <div class="rte product__description">{{ product.description }}</div>
                    {% endif %}

                    {% if has_details %}
                      <dl class="product__details">
                        {% for block in section.blocks %}
                          {% if block.settings.label != blank and block.settings.value != blank %}
                            <div class="product__detail" {{ block.shopify_attributes }}>
                              <dt>{{ block.settings.label | escape }}</dt>
                              <dd>{{ block.settings.value | escape }}</dd>
                            </div>
                          {% endif %}
                        {% endfor %}
                      </dl>
                    {% endif %}
                  </div>
                </details>
              {% endif %}

              {% if show_shipping %}
                <details class="product__accordion">
                  <summary class="product__accordion-summary">
                    {{ section.settings.shipping_heading | default: 'Shipping & Fulfillment' | escape }}
                  </summary>
                  <div class="product__accordion-body rte">
                    {{ section.settings.shipping_content }}
                  </div>
                </details>
              {% endif %}

              {% if show_warranty %}
                <details class="product__accordion">
                  <summary class="product__accordion-summary">
                    {{ section.settings.warranty_heading | default: 'Warranty & Returns' | escape }}
                  </summary>
                  <div class="product__accordion-body rte">
                    {{ section.settings.warranty_content }}
                  </div>
                </details>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .product__inner {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }

  .product__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem;
    color: var(--color-foreground-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .product__breadcrumb-link {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s var(--ease-out);
  }

  .product__breadcrumb-link:hover,
  .product__breadcrumb-link:focus-visible {
    color: var(--color-accent);
    border-bottom-color: currentcolor;
  }

  .product__layout {
    display: grid;
    gap: clamp(2.25rem, 5vw, 5rem);
    align-items: start;
  }

  /* Amazon-style gallery: thumbs + one framed stage. 4:5 + cover stops CLS. */
  .product__gallery {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    grid-template-areas:
      'stage'
      'thumbs';
  }

  .product__stage {
    position: relative;
    min-width: 0;
    grid-area: stage;
  }

  .product__stage-frame {
    aspect-ratio: 4 / 5;
    margin: 0;
    overflow: hidden;
    background: var(--color-surface);
  }

  .product__stage-frame[hidden] {
    display: none;
  }

  .product__image,
  .product__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product__thumbs {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: thin;
    grid-area: thumbs;
  }

  .product__thumb {
    display: block;
    width: 4.5rem;
    padding: 0;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    cursor: pointer;
  }

  .product__thumb-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .product__thumb[aria-pressed='true'] {
    border-color: var(--color-accent);
    box-shadow: inset 0 0 0 1px var(--color-accent);
  }

  .product__thumb:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .product__info-sticky {
    display: block;
  }

  .product__identity {
    display: grid;
    gap: 0.85rem;
  }

  .product__drop {
    margin: 0;
  }

  .product__title {
    margin: 0;
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .product__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem;
    margin: 0;
  }

  /* The price is a primary decision point, so it is sized to be read at a
     glance rather than tucked under the title. */
  .product__price-current {
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .product__price-compare {
    color: var(--color-foreground-muted);
    font-size: var(--text-base);
  }

  /* Only reached when Shopify reports a real compare-at price. */
  .product__price:has(.product__price-compare:not([hidden])) .product__price-current {
    color: var(--color-accent-strong);
  }

  .product__form {
    display: grid;
    gap: clamp(1.5rem, 2.5vw, 2rem);
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
    padding-top: clamp(1.75rem, 3vw, 2.25rem);
    border-top: 1px solid var(--color-border);
  }

  .product__field {
    display: grid;
    gap: 0.7rem;
    justify-items: start;
  }

  .product__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  /* Variant / edition selector. One radio per Shopify variant, so the native
     product form still submits a variant id without a custom data model. */
  .product__variants {
    display: grid;
    gap: 0.7rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .product__variants-legend {
    padding: 0;
  }

  .product__variant-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
    gap: 0.6rem;
  }

  .product__variant {
    position: relative;
    display: grid;
  }

  .product__variant-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .product__variant-label {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    min-height: 3.75rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    cursor: pointer;
    transition:
      border-color 0.25s var(--ease-out),
      background-color 0.25s var(--ease-out);
  }

  .product__variant-label:hover {
    border-color: var(--color-border-strong);
  }

  .product__variant-title {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product__variant-meta {
    color: var(--color-foreground-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }

  .product__variant-meta--sold {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--text-2xs);
    font-weight: 700;
  }

  /* Selected edition is marked in the accent so the choice is unmistakable. */
  .product__variant-input:checked + .product__variant-label {
    border-color: var(--color-accent);
    box-shadow: inset 0 0 0 1px var(--color-accent);
    background: var(--color-accent-soft);
  }

  .product__variant-input:focus-visible + .product__variant-label {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .product__variant-input:not(:checked) + .product__variant-label:has(.product__variant-meta--sold) {
    color: var(--color-foreground-muted);
  }

  /* Quantity stepper. The number input stays the submitted source of truth. */
  .product__quantity-control {
    display: grid;
    grid-template-columns: 3rem minmax(3.25rem, 4rem) 3rem;
    border: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .product__quantity-step {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }

  .product__quantity-step:hover {
    background: var(--color-surface);
  }

  .product__quantity {
    min-height: 3rem;
    padding: 0.5rem 0.25rem;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: center;
    appearance: textfield;
  }

  .product__quantity::-webkit-outer-spin-button,
  .product__quantity::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .product__submit {
    width: 100%;
    min-height: 3.75rem;
    letter-spacing: var(--tracking-wider);
  }

  /* Trust signals sit directly under add to cart. */
  .product__trust {
    display: grid;
    gap: 0.45rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .product__trust-item {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    color: var(--color-foreground-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
  }

  .product__trust-item::before {
    content: '✓';
    flex: 0 0 auto;
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.8em;
  }

  /* Custom sizing is an enquiry, not a purchase, so it is visually separated
     from the add-to-cart path. */
  .product__custom {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
    padding: clamp(1.25rem, 2.5vw, 1.6rem);
    background: var(--color-surface);
    border-left: 2px solid var(--color-accent);
  }

  .product__custom-heading {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .product__custom-text {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .product__custom-cta {
    margin-top: 0.4rem;
  }

  .product__accordions {
    display: grid;
    margin-top: clamp(2rem, 3.5vw, 2.75rem);
    border-top: 1px solid var(--color-border);
  }

  .product__accordion {
    border-bottom: 1px solid var(--color-border);
  }

  .product__accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    padding-block: 0.85rem;
    cursor: pointer;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    list-style: none;
  }

  .product__accordion-summary::-webkit-details-marker {
    display: none;
  }

  .product__accordion-summary::after {
    content: '+';
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-accent);
    line-height: 1;
  }

  .product__accordion[open] .product__accordion-summary::after {
    content: '–';
  }

  .product__accordion-summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .product__accordion-body {
    padding-bottom: 1.25rem;
  }

  .product__description {
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .product__details {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .product__description + .product__details {
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
  }

  .product__detail {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .product__detail:first-child {
    border-top: 1px solid var(--color-border);
  }

  .product__detail dt {
    color: var(--color-foreground-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .product__detail dd {
    margin: 0;
    text-align: right;
    letter-spacing: 0.02em;
  }

  @media (min-width: 900px) {
    .product__layout {
      grid-template-columns: minmax(0, 1fr) clamp(22rem, 27vw, 30rem);
    }

    .product__gallery--thumbs {
      grid-template-columns: 4.75rem minmax(0, 1fr);
      grid-template-areas: 'thumbs stage';
      align-items: start;
    }

    .product__thumbs {
      flex-direction: column;
      overflow-x: visible;
      overflow-y: auto;
      max-height: min(70vh, 36rem);
    }

    .product__info {
      align-self: stretch;
    }

    .product__info-sticky {
      position: sticky;
      top: calc(var(--header-height) + 2rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product__breadcrumb-link,
    .product__variant-label {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    document.querySelectorAll('[data-product-gallery]').forEach(function (gallery) {
      const slides = gallery.querySelectorAll('[data-gallery-slide]');
      const thumbs = gallery.querySelectorAll('[data-gallery-thumb]');
      if (!slides.length) return;

      function showImage(imageId) {
        if (!imageId) return;
        let matched = false;

        slides.forEach(function (slide) {
          const on = slide.getAttribute('data-image-id') === imageId;
          slide.hidden = !on;
          if (on) matched = true;
        });

        if (!matched) return;

        thumbs.forEach(function (thumb) {
          thumb.setAttribute(
            'aria-pressed',
            thumb.getAttribute('data-image-id') === imageId ? 'true' : 'false'
          );
        });
      }

      thumbs.forEach(function (thumb) {
        thumb.addEventListener('click', function () {
          showImage(thumb.getAttribute('data-image-id'));
        });
      });

      gallery.showImage = showImage;
    });

    const roots = document.querySelectorAll('[data-product-purchase]');

    roots.forEach(function (root) {
      const variantInputs = root.querySelectorAll('[data-product-variant]');
      const priceEl = root.querySelector('[data-product-price]');
      const compareEl = root.querySelector('[data-product-compare]');
      const saleLabelEl = root.querySelector('[data-product-sale-label]');
      const submitEl = root.querySelector('[data-product-submit]');
      const quantityEl = root.querySelector('[data-quantity-input]');
      const gallery = root.closest('[data-product-root]')
        ? root.closest('[data-product-root]').querySelector('[data-product-gallery]')
        : null;

      function selectedVariantInput() {
        for (let index = 0; index < variantInputs.length; index += 1) {
          if (variantInputs[index].checked) return variantInputs[index];
        }
        return null;
      }

      function syncVariant() {
        const input = selectedVariantInput();
        if (!input) return;

        const available = input.getAttribute('data-available') === 'true';
        const price = input.getAttribute('data-price') || '';
        const compare = input.getAttribute('data-compare') || '';
        const imageId = input.getAttribute('data-image-id');

        if (priceEl) priceEl.textContent = price;

        if (compareEl) {
          if (compare) {
            compareEl.textContent = compare;
            compareEl.hidden = false;
          } else {
            compareEl.hidden = true;
          }
        }

        if (saleLabelEl) saleLabelEl.hidden = !compare;

        if (submitEl) {
          submitEl.disabled = !available;
          submitEl.textContent = available
            ? submitEl.getAttribute('data-add-label')
            : submitEl.getAttribute('data-sold-label');
        }

        if (imageId && gallery && typeof gallery.showImage === 'function') {
          gallery.showImage(imageId);
        }

        if (window.history && window.history.replaceState) {
          const url = new URL(window.location.href);
          url.searchParams.set('variant', input.value);
          window.history.replaceState({}, '', url.toString());
        }
      }

      variantInputs.forEach(function (input) {
        input.addEventListener('change', syncVariant);
      });

      if (quantityEl) {
        root.querySelectorAll('[data-quantity-step]').forEach(function (button) {
          button.addEventListener('click', function () {
            const step = parseInt(button.getAttribute('data-quantity-step'), 10) || 0;
            const min = parseInt(quantityEl.getAttribute('min'), 10) || 1;
            const current = parseInt(quantityEl.value, 10) || min;
            const next = current + step;

            quantityEl.value = next < min ? min : next;
            quantityEl.dispatchEvent(new Event('change', { bubbles: true }));
          });
        });
      }
    });
  })();
{% endjavascript %}

