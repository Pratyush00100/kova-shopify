{% comment %}
  This section is used in the product template to render the product page with
  media, content, and the add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign parent_collection = product.collections.first
%}

<div class="product full-width section-pad">
  <div class="product__inner page-inner">
    {% if parent_collection != blank %}
      <nav class="product__breadcrumb" aria-label="{{ 'accessibility.breadcrumb' | t }}">
        <a class="link-underline" href="{{ parent_collection.url }}">
          &larr; {{ parent_collection.title | escape }}
        </a>
      </nav>
    {% endif %}

    <div class="product__layout">
      <div class="product__media">
        {% if product.media.size > 0 %}
          {% for image in product.images %}
            {% liquid
              assign image_loading = 'lazy'
              if forloop.first
                assign image_loading = 'eager'
              endif
            %}
            <div class="product__media-item">
              {{
                image
                | image_url: width: 1600
                | image_tag:
                  class: 'product__image',
                  widths: '500, 700, 900, 1200, 1600',
                  sizes: '(min-width: 900px) 55vw, 100vw',
                  loading: image_loading
              }}
            </div>
          {% endfor %}
        {% else %}
          <div class="product__media-item">
            {{ 'product-1' | placeholder_svg_tag: 'media-placeholder product__placeholder' }}
          </div>
        {% endif %}
      </div>

      <div class="product__info">
        <div class="product__info-sticky">
          {% if section.settings.eyebrow != blank %}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}

          <h1 class="product__title">{{ product.title | escape }}</h1>

          <p class="product__price">
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="visually-hidden">{{ 'products.sale_price' | t }}</span>
              {{ current_variant.price | money }}
              <s class="product__price-compare">{{ current_variant.compare_at_price | money }}</s>
            {% else %}
              {{ current_variant.price | money }}
            {% endif %}
          </p>

          {% form 'product', product, class: 'product__form' %}
            {% if product.variants.size > 1 %}
              <div class="product__field">
                <label class="product__label" for="ProductVariant-{{ section.id }}">
                  {{ product.options | join: ' / ' | escape }}
                </label>

                <select
                  id="ProductVariant-{{ section.id }}"
                  class="product__select"
                  name="id"
                >
                  {% for variant in product.variants %}
                    <option
                      value="{{ variant.id }}"
                      {% if variant == current_variant %}
                        selected="selected"
                      {% endif %}
                      {% unless variant.available %}
                        disabled
                      {% endunless %}
                    >
                      {{ variant.title }} — {{ variant.price | money }}
                      {%- unless variant.available %} ({{ 'products.sold_out' | t }}){% endunless -%}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% else %}
              <input type="hidden" name="id" value="{{ current_variant.id }}">
            {% endif %}

            <div class="product__field product__field--quantity">
              <label class="product__label" for="ProductQuantity-{{ section.id }}">
                {{ 'products.quantity' | t }}
              </label>

              <input
                id="ProductQuantity-{{ section.id }}"
                class="product__quantity"
                type="number"
                name="quantity"
                value="1"
                min="1"
                step="1"
              >
            </div>

            <button
              class="btn product__submit"
              type="submit"
              name="add"
              {% unless product.available %}
                disabled
              {% endunless %}
            >
              {% if product.available %}
                {{ 'products.add_to_cart' | t }}
              {% else %}
                {{ 'products.sold_out' | t }}
              {% endif %}
            </button>
          {% endform %}

          {% if product.description != blank %}
            <div class="rte product__description">{{ product.description }}</div>
          {% endif %}

          {% assign has_details = false %}
          {% for block in section.blocks %}
            {% if block.settings.label != blank and block.settings.value != blank %}
              {% assign has_details = true %}
            {% endif %}
          {% endfor %}

          {% if has_details %}
            <dl class="product__details">
              {% for block in section.blocks %}
                {% if block.settings.label != blank and block.settings.value != blank %}
                  <div class="product__detail" {{ block.shopify_attributes }}>
                    <dt>{{ block.settings.label | escape }}</dt>
                    <dd>{{ block.settings.value | escape }}</dd>
                  </div>
                {% endif %}
              {% endfor %}
            </dl>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .product__inner {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .product__layout {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .product__media {
    display: grid;
    gap: 1rem;
  }

  .product__media-item {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .product__image,
  .product__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product__info-sticky {
    display: grid;
    gap: 1.15rem;
  }

  .product__title {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .product__price {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
  }

  .product__price-compare {
    color: var(--color-foreground-muted);
    margin-left: 0.5rem;
  }

  .product__form {
    display: grid;
    gap: 1rem;
    padding-block: 0.5rem;
  }

  .product__field {
    display: grid;
    gap: 0.5rem;
  }

  .product__label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .product__select,
  .product__quantity {
    min-height: 3rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-foreground);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
  }

  .product__quantity {
    width: 6rem;
  }

  .product__submit {
    width: 100%;
  }

  .product__details {
    display: grid;
    gap: 0;
    margin: 0.5rem 0 0;
    border-top: 1px solid var(--color-border);
  }

  .product__detail {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product__detail dt {
    color: var(--color-foreground-muted);
  }

  .product__detail dd {
    margin: 0;
    text-align: right;
  }

  @media (min-width: 900px) {
    .product__layout {
      grid-template-columns: minmax(0, 1.35fr) minmax(20rem, 0.75fr);
    }

    .product__info-sticky {
      position: sticky;
      top: calc(var(--header-height) + 2rem);
    }

    .product__submit {
      width: auto;
      justify-self: start;
      min-width: 14rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "DROP 001"
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "t:general.detail",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.detail_label",
          "default": "Material"
        },
        {
          "type": "text",
          "id": "value",
          "label": "t:labels.detail_value"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
