{% comment %}
  KOVA product buy box. Catalog data comes from Shopify: title, description,
  media, variants, prices and availability. Theme settings hold labels only.
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign drop_collection = nil
  assign drop_index = 0
  assign drop_count = 0
  assign image_count = product.images.size

  for collection in product.collections
    if collection.handle == 'drop-001'
      assign drop_collection = collection
      break
    endif
  endfor

  if drop_collection == blank
    for collection in product.collections
      unless collection.handle == 'all'
        assign drop_collection = collection
        break
      endunless
    endfor
  endif

  if drop_collection != blank
    assign drop_label = drop_collection.title
    assign drop_count = drop_collection.products_count
    for drop_product in drop_collection.products
      if drop_product.id == product.id
        assign drop_index = forloop.index
        break
      endif
    endfor
  else
    assign drop_label = section.settings.eyebrow
  endif

  if drop_index > 0
    assign drop_index_label = drop_index | prepend: '00' | slice: -2, 2
    assign drop_count_label = drop_count | prepend: '00' | slice: -2, 2
  endif

  if image_count > 0
    assign image_count_label = image_count | prepend: '00' | slice: -2, 2
  endif
%}

<div class="product full-width" data-product-root>
  <div class="product__bar">
    <div class="product__bar-inner page-inner">
      <nav class="product__breadcrumb" aria-label="{{ 'accessibility.breadcrumb' | t }}">
        <a class="product__breadcrumb-link" href="{{ routes.root_url }}">
          {{- 'general.home' | t -}}
        </a>

        {% if drop_collection != blank %}
          <span class="product__breadcrumb-divider" aria-hidden="true">/</span>
          <a class="product__breadcrumb-link" href="{{ drop_collection.url }}">
            {{- drop_collection.title | escape -}}
          </a>
        {% endif %}

        <span class="product__breadcrumb-divider" aria-hidden="true">/</span>
        <span class="product__breadcrumb-current" aria-current="page">{{ product.title | escape }}</span>
      </nav>

      {% if section.settings.origin_label != blank %}
        <p class="product__origin">
          <span>{{ section.settings.origin_label | escape }}</span>
          <span aria-hidden="true">→</span>
        </p>
      {% endif %}
    </div>
  </div>

  <div class="product__inner page-inner">
    <div class="product__layout">
      <div class="product__gallery" data-product-gallery>
        <div class="product__stage">
          {% if image_count > 0 %}
            {% for image in product.images %}
              <figure
                class="product__stage-frame"
                data-gallery-slide
                data-image-id="{{ image.id }}"
                data-image-index="{{ forloop.index }}"
                {% unless forloop.first %}
                  hidden
                {% endunless %}
              >
                {% if forloop.first %}
                  {{
                    image
                    | image_url: width: 1800
                    | image_tag:
                      class: 'product__image',
                      widths: '600, 800, 1000, 1200, 1500, 1800',
                      sizes: '(min-width: 900px) min(32rem, 45vw), 100vw',
                      loading: 'eager',
                      fetchpriority: 'high'
                  }}
                {% else %}
                  {{
                    image
                    | image_url: width: 1800
                    | image_tag:
                      class: 'product__image',
                      widths: '600, 800, 1000, 1200, 1500, 1800',
                      sizes: '(min-width: 900px) min(32rem, 45vw), 100vw',
                      loading: 'lazy',
                      fetchpriority: 'low'
                  }}
                {% endif %}
              </figure>
            {% endfor %}
          {% else %}
            <div class="product__stage-frame product__stage-frame--placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'media-placeholder product__placeholder' }}
            </div>
          {% endif %}

          {% if section.settings.origin_label != blank %}
            <div class="product__stamp" aria-hidden="true">
              <span class="product__stamp-text">{{ section.settings.origin_label | escape }}</span>
            </div>
          {% endif %}

          {% if image_count > 0 %}
            <p class="product__counter" data-gallery-counter>
              {{ 'products.image_counter' | t: index: '01', count: image_count_label }}
            </p>
          {% endif %}
        </div>

        {% if image_count > 1 %}
          <ul class="product__thumbs" role="list">
            {% for image in product.images %}
              <li class="product__thumb-item">
                <button
                  class="product__thumb"
                  type="button"
                  data-gallery-thumb
                  data-image-id="{{ image.id }}"
                  aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-label="{{ 'products.view_image' | t: index: forloop.index, count: image_count }}"
                >
                  {{
                    image
                    | image_url: width: 240
                    | image_tag:
                      class: 'product__thumb-image',
                      widths: '120, 180, 240',
                      sizes: '72px',
                      loading: 'lazy',
                      fetchpriority: 'low',
                      alt: ''
                  }}
                </button>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      <div class="product__info">
        <div class="product__info-sticky" data-product-purchase>
          <div class="product__identity">
            {% if drop_label != blank %}
              <p class="product__drop">
                <span>{{ drop_label | escape }}</span>
                {% if drop_index > 0 %}
                  <span class="product__drop-index">{{ drop_index_label }} / {{ drop_count_label }}</span>
                {% endif %}
              </p>
            {% endif %}

            <h1 class="product__title">{{ product.title | escape }}</h1>

            {% if section.settings.subtitle != blank %}
              <p class="product__subtitle">{{ section.settings.subtitle | escape }}</p>
            {% endif %}

            <p class="product__price" aria-live="polite">
              <span
                class="visually-hidden"
                data-product-sale-label
                {% unless current_variant.compare_at_price > current_variant.price %}
                  hidden
                {% endunless %}
              >
                {{ 'products.sale_price' | t }}
              </span>
              <span class="product__price-current" data-product-price>{{ current_variant.price | money }}</span>
              <s
                class="product__price-compare"
                data-product-compare
                {% unless current_variant.compare_at_price > current_variant.price %}
                  hidden
                {% endunless %}
              >
                {{ current_variant.compare_at_price | money }}
              </s>
              <span class="product__price-tax">{{ 'products.incl_taxes' | t }}</span>
            </p>
          </div>

          {% form 'product', product, class: 'product__form' %}
            <input type="hidden" name="quantity" value="1">

            {% if product.variants.size > 0 %}
              <fieldset class="product__variants">
                <legend class="visually-hidden">{{ product.options | join: ' / ' | escape }}</legend>

                <div class="product__variant-grid">
                  {% for variant in product.variants %}
                    {% liquid
                      assign size_name = variant.metafields.custom.size_name.value
                      if size_name == blank
                        assign size_name = variant.title
                      endif
                      assign variant_dimensions = variant.metafields.custom.dimensions.value
                    %}

                    <div class="product__variant">
                      <input
                        id="ProductVariant-{{ section.id }}-{{ variant.id }}"
                        class="product__variant-input"
                        type="radio"
                        name="id"
                        value="{{ variant.id }}"
                        data-product-variant
                        data-available="{% if variant.available %}true{% else %}false{% endif %}"
                        data-price="{{ variant.price | money | escape }}"
                        data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                        {% if variant.image %}
                          data-image-id="{{ variant.image.id }}"
                        {% endif %}
                        {% if variant == current_variant %}
                          checked
                        {% endif %}
                      >

                      <label
                        class="product__variant-label"
                        for="ProductVariant-{{ section.id }}-{{ variant.id }}"
                      >
                        <span class="product__variant-heading">
                          <span class="product__variant-title">{{ size_name | escape }}</span>
                          {% if variant_dimensions != blank %}
                            <span class="product__variant-meta">{{ variant_dimensions | escape }}</span>
                          {% endif %}
                        </span>

                        <span class="product__variant-meta product__variant-price">{{ variant.price | money }}</span>

                        {% unless variant.available %}
                          <span class="product__variant-meta product__variant-meta--sold">
                            {{- 'products.sold_out' | t -}}
                          </span>
                        {% endunless %}
                      </label>
                    </div>
                  {% endfor %}
                </div>
              </fieldset>
            {% endif %}

            <input type="hidden" name="return_to" value="{{ routes.root_url }}checkout" disabled data-product-return>

            <div class="product__actions">
              <button
                class="btn product__submit"
                type="submit"
                name="add"
                data-product-submit
                data-add-label="{{ 'products.add_to_cart' | t | escape }}"
                data-sold-label="{{ 'products.sold_out' | t | escape }}"
                {% unless current_variant.available %}
                  disabled
                {% endunless %}
              >
                <span data-product-submit-label>
                  {% if current_variant.available %}
                    {{ 'products.add_to_cart' | t }}
                  {% else %}
                    {{ 'products.sold_out' | t }}
                  {% endif %}
                </span>
                <span class="product__submit-arrow" aria-hidden="true">→</span>
              </button>

              <button
                class="btn btn--ghost product__buy-now"
                type="submit"
                name="add"
                data-product-buy-now
                data-buy-label="{{ 'products.buy_now' | t | escape }}"
                data-sold-label="{{ 'products.sold_out' | t | escape }}"
                data-cart-add="{{ routes.cart_add_url }}.js"
                data-checkout="{{ routes.root_url }}checkout"
                {% unless current_variant.available %}
                  disabled
                {% endunless %}
              >
                <span data-product-buy-now-label>
                  {% if current_variant.available %}
                    {{ 'products.buy_now' | t }}
                  {% else %}
                    {{ 'products.sold_out' | t }}
                  {% endif %}
                </span>
                <span class="product__submit-arrow" aria-hidden="true">→</span>
              </button>
            </div>
          {% endform %}
        </div>
      </div>

      {% if product.description != blank %}
        <div class="rte product__description">{{ product.description }}</div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .product__bar {
    border-bottom: 1px solid var(--color-border);
  }

  .product__bar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    min-height: 2.85rem;
  }

  .product__breadcrumb,
  .product__origin {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .product__breadcrumb-link {
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }

  .product__breadcrumb-link:hover,
  .product__breadcrumb-link:focus-visible {
    color: var(--color-foreground);
    border-bottom-color: currentcolor;
  }

  .product__breadcrumb-current {
    color: var(--color-foreground);
  }

  .product__inner {
    padding-block: clamp(1.75rem, 4vw, 3.25rem) var(--space-section);
  }

  .product__layout {
    display: grid;
    gap: clamp(2.25rem, 5vw, 4.5rem);
    align-items: start;
    grid-template-areas:
      'gallery'
      'info'
      'description';
  }

  .product__gallery {
    display: grid;
    gap: 0.85rem;
    min-width: 0;
    grid-area: gallery;
  }

  .product__info {
    grid-area: info;
    min-width: 0;
  }

  .product__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 0;
    background: var(--color-surface);
  }

  .product__stage-frame {
    aspect-ratio: 1 / 1;
    inline-size: min(100%, 32rem, 70dvb);
    block-size: auto;
    margin: 0 auto;
    overflow: clip;
  }

  .product__stage-frame[hidden] {
    display: none;
  }

  .product__image,
  .product__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product__stamp {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 5.75rem;
    height: 5.75rem;
    padding: 0.7rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 78%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-background) 28%, transparent);
    color: var(--color-foreground);
    text-align: center;
    pointer-events: none;
  }

  .product__stamp-text {
    font-family: var(--font-mono--family);
    font-size: 0.52rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .product__counter {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    z-index: 2;
    margin: 0;
    color: var(--color-foreground);
    font-family: var(--font-mono--family);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .product__thumbs {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .product__thumb {
    display: block;
    width: 4.5rem;
    padding: 0;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    cursor: pointer;
  }

  .product__thumb-image {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
  }

  .product__thumb[aria-pressed='true'] {
    border-color: var(--color-foreground);
  }

  .product__thumb:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .product__info-sticky {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.15rem);
  }

  .product__identity {
    display: grid;
    gap: 0.85rem;
  }

  .product__drop {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin: 0;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .product__title {
    margin: 0;
    font-family: var(--font-display--family);
    font-style: var(--font-display--style);
    font-weight: var(--font-display--weight);
    font-size: clamp(2.15rem, 5vw, 3.6rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .product__subtitle {
    margin: 0;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .product__description {
    grid-area: description;
    min-width: 0;
    max-width: 38rem;
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .product__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem 0.7rem;
    margin: 0;
  }

  .product__price-current {
    font-family: var(--font-display--family);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    font-weight: var(--font-display--weight);
    letter-spacing: 0.02em;
  }

  .product__price-compare {
    color: var(--color-foreground-muted);
    font-size: var(--text-base);
  }

  .product__price-tax {
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product__form {
    display: grid;
    gap: 1.35rem;
  }

  .product__variants {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .product__variant-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .product__variant {
    position: relative;
    display: grid;
    min-width: 0;
  }

  .product__variant-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .product__variant-label {
    display: grid;
    align-content: start;
    gap: 0.28rem;
    min-height: 0;
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    cursor: pointer;
    transition: border-color 0.25s var(--ease-out);
  }

  .product__variant-label:hover {
    border-color: var(--color-border-strong);
  }

  .product__variant-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.65rem;
  }

  .product__variant-title {
    font-family: var(--font-display--family);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product__variant-meta {
    color: var(--color-foreground-muted);
    font-family: var(--font-mono--family);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  .product__variant-price {
    color: var(--color-foreground);
  }

  .product__variant-meta--sold {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--text-2xs);
    font-weight: 700;
  }

  .product__variant-input:checked + .product__variant-label {
    border-color: var(--color-foreground);
    box-shadow: inset 0 0 0 1px var(--color-foreground);
  }

  .product__variant-input:focus-visible + .product__variant-label {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }

  .product__variant-input:not(:checked) + .product__variant-label:has(.product__variant-meta--sold) {
    color: var(--color-foreground-muted);
  }

  .product__submit {
    width: 100%;
    min-height: 3.6rem;
    justify-content: space-between;
    padding-inline: 1.25rem;
    border-color: var(--color-foreground);
    background: color-mix(in srgb, var(--color-foreground) 88%, var(--color-background));
    color: var(--color-background);
    letter-spacing: var(--tracking-wider);
  }

  .product__submit:hover,
  .product__submit:focus-visible {
    background: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background);
  }

  .product__submit-arrow {
    font-size: 1.15rem;
    line-height: 1;
  }

  .product__actions {
    display: grid;
    gap: 0.65rem;
  }

  .product__buy-now {
    width: 100%;
    min-height: 3.6rem;
    justify-content: space-between;
    padding-inline: 1.25rem;
    letter-spacing: var(--tracking-wider);
  }

  @media (min-width: 900px) {
    .product__layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
      grid-template-areas:
        'gallery info'
        'description info';
    }

    .product__info-sticky {
      position: sticky;
      top: calc(var(--header-height) + 1.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product__breadcrumb-link,
    .product__variant-label,
    .product__submit,
    .product__buy-now {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function padIndex(value) {
      const number = Number(value) || 0;
      return number < 10 ? '0' + number : String(number);
    }

    document.querySelectorAll('[data-product-gallery]').forEach(function (gallery) {
      const root = gallery.closest('[data-product-root]');
      const slides = gallery.querySelectorAll('[data-gallery-slide]');
      const thumbs = gallery.querySelectorAll('[data-gallery-thumb]');
      const counter = root ? root.querySelector('[data-gallery-counter]') : null;
      const total = slides.length;
      if (!slides.length) return;

      function showImage(imageId) {
        if (!imageId) return;
        let matched = false;
        let visibleIndex = 1;

        slides.forEach(function (slide) {
          const on = slide.getAttribute('data-image-id') === imageId;
          slide.hidden = !on;
          if (on) {
            matched = true;
            visibleIndex = parseInt(slide.getAttribute('data-image-index'), 10) || 1;
          }
        });

        if (!matched) return;

        thumbs.forEach(function (thumb) {
          thumb.setAttribute(
            'aria-pressed',
            thumb.getAttribute('data-image-id') === imageId ? 'true' : 'false'
          );
        });

        if (counter) {
          counter.textContent = padIndex(visibleIndex) + ' / ' + padIndex(total);
        }
      }

      thumbs.forEach(function (thumb) {
        thumb.addEventListener('click', function () {
          showImage(thumb.getAttribute('data-image-id'));
        });
      });

      gallery.showImage = showImage;
    });

    document.querySelectorAll('[data-product-purchase]').forEach(function (root) {
      const variantInputs = root.querySelectorAll('[data-product-variant]');
      const priceEl = root.querySelector('[data-product-price]');
      const compareEl = root.querySelector('[data-product-compare]');
      const saleLabelEl = root.querySelector('[data-product-sale-label]');
      const submitEl = root.querySelector('[data-product-submit]');
      const submitLabelEl = root.querySelector('[data-product-submit-label]');
      const buyNowEl = root.querySelector('[data-product-buy-now]');
      const buyNowLabelEl = root.querySelector('[data-product-buy-now-label]');
      const returnToEl = root.querySelector('[data-product-return]');
      const gallery = root.closest('[data-product-root]')
        ? root.closest('[data-product-root]').querySelector('[data-product-gallery]')
        : null;

      function selectedVariantInput() {
        for (let index = 0; index < variantInputs.length; index += 1) {
          if (variantInputs[index].checked) return variantInputs[index];
        }
        return null;
      }

      function syncVariant() {
        const input = selectedVariantInput();
        if (!input) return;

        const available = input.getAttribute('data-available') === 'true';
        const price = input.getAttribute('data-price') || '';
        const compare = input.getAttribute('data-compare') || '';
        const imageId = input.getAttribute('data-image-id');
        const addLabel = submitEl ? submitEl.getAttribute('data-add-label') : '';
        const soldLabel = submitEl ? submitEl.getAttribute('data-sold-label') : '';
        const buyLabel = buyNowEl ? buyNowEl.getAttribute('data-buy-label') : '';
        const buySoldLabel = buyNowEl ? buyNowEl.getAttribute('data-sold-label') : soldLabel;
        const label = available ? addLabel : soldLabel;
        const buyNowLabel = available ? buyLabel : buySoldLabel;

        if (priceEl) priceEl.textContent = price;

        if (compareEl) {
          if (compare) {
            compareEl.textContent = compare;
            compareEl.hidden = false;
          } else {
            compareEl.hidden = true;
          }
        }

        if (saleLabelEl) saleLabelEl.hidden = !compare;

        if (submitEl) {
          submitEl.disabled = !available;
          if (submitLabelEl) {
            submitLabelEl.textContent = label;
          } else {
            submitEl.textContent = label;
          }
        }

        if (buyNowEl) {
          buyNowEl.disabled = !available;
          if (buyNowLabelEl) {
            buyNowLabelEl.textContent = buyNowLabel;
          }
        }

        if (imageId && gallery && typeof gallery.showImage === 'function') {
          gallery.showImage(imageId);
        }

        if (window.history && window.history.replaceState) {
          const url = new URL(window.location.href);
          url.searchParams.set('variant', input.value);
          window.history.replaceState({}, '', url.toString());
        }
      }

      if (submitEl && returnToEl) {
        submitEl.addEventListener('click', function () {
          returnToEl.disabled = true;
        });
      }

      if (buyNowEl) {
        buyNowEl.addEventListener('click', function (event) {
          const form = buyNowEl.closest('form');
          const addUrl = buyNowEl.getAttribute('data-cart-add');
          const checkoutUrl = buyNowEl.getAttribute('data-checkout');

          if (returnToEl) returnToEl.disabled = false;

          if (!form || !addUrl || !checkoutUrl) return;

          event.preventDefault();
          buyNowEl.disabled = true;

          const formData = new FormData(form);
          formData.delete('return_to');

          fetch(addUrl, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: formData
          })
            .then(function (response) {
              if (!response.ok) throw new Error('Add failed');
              window.location.href = checkoutUrl;
            })
            .catch(function () {
              buyNowEl.disabled = false;
              form.submit();
            });
        });
      }

      variantInputs.forEach(function (input) {
        input.addEventListener('change', syncVariant);
      });
    });
  })();
{% endjavascript %}

