{% comment %}
  Shows more pieces from the same drop. Defaults to the first collection the
  product belongs to, with a theme editor override for a specific collection.
{% endcomment %}

{% liquid
  assign source_collection = section.settings.collection
  if source_collection == blank
    assign source_collection = product.collections.first
  endif
%}

{% if source_collection != blank and source_collection.products_count > 1 %}
  <section class="related full-width section-pad">
    <div class="related__inner page-inner">
      <header class="related__header">
        {% if section.settings.heading != blank %}
          <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        <a class="link-underline" href="{{ source_collection.url }}">
          {{ 'collections.view_all' | t }}
        </a>
      </header>

      <ul class="related__grid" role="list" style="--columns: {{ section.settings.columns }}">
        {% assign rendered = 0 %}
        {% for related_product in source_collection.products %}
          {% if related_product.id != product.id and rendered < section.settings.products_to_show %}
            <li class="related__item">
              {% render 'product-card', product: related_product %}
            </li>
            {% assign rendered = rendered | plus: 1 %}
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .related {
    border-top: 1px solid var(--color-border);
  }

  .related__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .related__header {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .related__grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }

  @media (min-width: 600px) {
    .related__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .related__grid {
      grid-template-columns: repeat(var(--columns, 3), 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.related_products",
  "tag": "div",
  "class": "section-related-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "MORE FROM THIS DROP"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection",
      "info": "t:info.related_collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
