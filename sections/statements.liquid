{% comment %}
  Large editorial statements used on the MANIFESTO page. Each statement is a
  block so the copy can be rewritten entirely from the theme editor.
{% endcomment %}

<section class="statements full-width section-pad">
  <div class="statements__inner page-inner">
    {% if section.settings.heading != blank %}
      <h2 class="section-title statements__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ol class="statements__list">
        {% for block in section.blocks %}
          {% liquid
            assign statement_text = block.settings.statement | strip
            assign description_text = block.settings.description | strip_html | strip
          %}

          {% if statement_text == 'Made in India, built for anywhere.' %}
            {% continue %}
          {% endif %}

          {% if statement_text != blank or description_text != blank %}
            <li
              class="statements__item{% if description_text == blank %} statements__item--statement-only{% endif %}"
              {{ block.shopify_attributes }}
            >
              <p class="statements__index" aria-hidden="true">
                {{ forloop.index | prepend: '0' | slice: -2, 2 }}
              </p>

              <div class="statements__body">
                {% if statement_text != blank %}
                  <p class="statements__statement">{{ block.settings.statement | escape }}</p>
                {% endif %}

                {% if description_text != blank %}
                  <div class="rte statements__description">{{ block.settings.description }}</div>
                {% endif %}
              </div>
            </li>
          {% endif %}
        {% endfor %}
      </ol>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .statements__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .statements__list {
    display: grid;
    gap: clamp(2rem, 4vw, 3.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .statements__item {
    display: grid;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .statements__index {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .statements__body {
    display: grid;
    gap: 1rem;
  }

  .statements__statement {
    margin: 0;
    font-size: clamp(1.35rem, 3.2vw, 2.35rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .statements__description {
    max-width: 52ch;
  }

  @media (min-width: 900px) {
    .statements__item {
      grid-template-columns: 6rem 1fr;
      gap: 2rem;
    }

    .statements__item:not(.statements__item--statement-only) .statements__body {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 2.5rem;
      align-items: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.statements",
  "tag": "div",
  "class": "section-statements",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "PRINCIPLES"
    }
  ],
  "blocks": [
    {
      "type": "statement",
      "name": "t:general.statement",
      "settings": [
        {
          "type": "text",
          "id": "statement",
          "label": "t:labels.statement"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:labels.description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.statements"
    }
  ]
}
{% endschema %}
