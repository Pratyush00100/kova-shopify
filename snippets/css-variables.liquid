{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};

    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    /* Base surface: warm paper against cool graphite ink. */
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-foreground-muted: color-mix(in srgb, {{ settings.foreground_color }} 62%, {{ settings.background_color }});
    /* Decorative only. Does not meet text contrast — use --color-foreground-muted for copy. */
    --color-foreground-subtle: color-mix(in srgb, {{ settings.foreground_color }} 42%, {{ settings.background_color }});
    --color-border: color-mix(in srgb, {{ settings.foreground_color }} 14%, {{ settings.background_color }});
    --color-border-strong: color-mix(in srgb, {{ settings.foreground_color }} 28%, {{ settings.background_color }});
    --color-surface: color-mix(in srgb, {{ settings.foreground_color }} 5%, {{ settings.background_color }});
    --color-surface-strong: color-mix(in srgb, {{ settings.foreground_color }} 10%, {{ settings.background_color }});

    /* Ember accent: the heat colour of cut steel. Used for action, not decoration. */
    --color-accent: {{ settings.accent_color }};
    --color-accent-strong: color-mix(in srgb, {{ settings.accent_color }} 78%, {{ settings.foreground_color }});
    --color-accent-soft: color-mix(in srgb, {{ settings.accent_color }} 12%, {{ settings.background_color }});
    --color-accent-contrast: {{ settings.accent_contrast_color }};

    /* Inverted panels: hero, notify, any dark field. */
    --color-inverse: {{ settings.dark_color }};
    --color-inverse-foreground: #ffffff;
    --color-inverse-muted: color-mix(in srgb, #ffffff 62%, {{ settings.dark_color }});
    --color-inverse-subtle: color-mix(in srgb, #ffffff 38%, {{ settings.dark_color }});
    --color-inverse-border: color-mix(in srgb, #ffffff 20%, {{ settings.dark_color }});
    --color-inverse-surface: color-mix(in srgb, #ffffff 7%, {{ settings.dark_color }});

    /* Fluid type scale. */
    --text-2xs: 0.625rem;
    --text-xs: 0.72rem;
    --text-sm: 0.82rem;
    --text-base: clamp(0.95rem, 0.92rem + 0.15vw, 1.05rem);
    --text-lg: clamp(1.05rem, 1rem + 0.3vw, 1.25rem);
    --text-xl: clamp(1.2rem, 1.1rem + 0.5vw, 1.5rem);
    --display-sm: clamp(1.6rem, 3.5vw, 2.5rem);
    --display-md: clamp(2.1rem, 5.5vw, 3.75rem);
    --display-lg: clamp(2.75rem, 8vw, 6rem);

    --tracking-wide: 0.16em;
    --tracking-wider: 0.2em;

    /* Vertical rhythm. */
    --space-section: clamp(3.5rem, 9vw, 7rem);
    --space-section-lg: clamp(4.5rem, 12vw, 9rem);
    --space-block: clamp(1.5rem, 3vw, 2.5rem);

    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --header-height: 4.25rem;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --duration: 0.3s;
  }
{% endstyle %}
