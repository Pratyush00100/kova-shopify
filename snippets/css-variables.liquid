{% style %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  {{ settings.type_display_font | font_face: font_display: 'swap' }}
  {{ settings.type_display_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}

  {{ settings.type_mono_font | font_face: font_display: 'swap' }}
  {{ settings.type_mono_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}

  :root {
    color-scheme: dark;
    accent-color: {{ settings.accent_color }};

    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};

    --font-display--family: {{ settings.type_display_font.family }}, {{ settings.type_display_font.fallback_families }};
    --font-display--style: {{ settings.type_display_font.style }};
    --font-display--weight: {{ settings.type_display_font.weight }};

    --font-mono--family: {{ settings.type_mono_font.family }}, {{ settings.type_mono_font.fallback_families }};
    --font-mono--style: {{ settings.type_mono_font.style }};
    --font-mono--weight: {{ settings.type_mono_font.weight }};

    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-foreground-muted: color-mix(in srgb, {{ settings.foreground_color }} 62%, {{ settings.background_color }});
    --color-foreground-subtle: color-mix(in srgb, {{ settings.foreground_color }} 38%, {{ settings.background_color }});
    --color-border: color-mix(in srgb, {{ settings.foreground_color }} 16%, {{ settings.background_color }});
    --color-border-strong: color-mix(in srgb, {{ settings.foreground_color }} 42%, {{ settings.background_color }});
    --color-surface: color-mix(in srgb, {{ settings.foreground_color }} 6%, {{ settings.background_color }});
    --color-surface-strong: color-mix(in srgb, {{ settings.foreground_color }} 10%, {{ settings.background_color }});

    --color-accent: {{ settings.accent_color }};
    --color-accent-strong: color-mix(in srgb, {{ settings.accent_color }} 86%, {{ settings.foreground_color }});
    --color-accent-soft: color-mix(in srgb, {{ settings.accent_color }} 10%, {{ settings.background_color }});
    --color-accent-contrast: {{ settings.accent_contrast_color }};

    --color-inverse: {{ settings.dark_color }};
    --color-inverse-foreground: {{ settings.foreground_color }};
    --color-inverse-muted: color-mix(in srgb, {{ settings.foreground_color }} 62%, {{ settings.dark_color }});
    --color-inverse-subtle: color-mix(in srgb, {{ settings.foreground_color }} 38%, {{ settings.dark_color }});
    --color-inverse-border: color-mix(in srgb, {{ settings.foreground_color }} 16%, {{ settings.dark_color }});
    --color-inverse-surface: color-mix(in srgb, {{ settings.foreground_color }} 7%, {{ settings.dark_color }});

    --text-2xs: 0.625rem;
    --text-xs: 0.72rem;
    --text-sm: 0.82rem;
    --text-base: clamp(0.95rem, 0.92rem + 0.15vw, 1.05rem);
    --text-lg: clamp(1.05rem, 1rem + 0.3vw, 1.25rem);
    --text-xl: clamp(1.2rem, 1.1rem + 0.5vw, 1.5rem);
    --display-sm: clamp(1.7rem, 3.8vw, 2.75rem);
    --display-md: clamp(2.25rem, 6vw, 4.25rem);
    --display-lg: clamp(3rem, 9vw, 6.5rem);

    --tracking-wide: 0.16em;
    --tracking-wider: 0.22em;

    --space-section: clamp(3.5rem, 9vw, 7rem);
    --space-section-lg: clamp(4.5rem, 12vw, 9rem);
    --space-block: clamp(1.5rem, 3vw, 2.5rem);

    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --header-height: 4.5rem;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --duration: 0.3s;
  }
{% endstyle %}
