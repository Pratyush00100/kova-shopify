{% doc %}
  Renders a KOVA product card linking to the product page.

  Shared by the collection grid, the homepage featured products and the PDP
  related products, so the catalog keeps one card language. Photography, title
  and price all come from Shopify. Do not substitute decorative wall-art photos.

  Falls back to a Shopify placeholder illustration when the product has no image,
  so the grid stays intact before final photography is available.

  @param {object} product - The product to render
  @param {string} [placeholder] - Placeholder SVG name used when the product has no image
  @param {boolean} [show_price] - Whether the price is displayed. Defaults to true

  @example
  {% render 'product-card', product: product %}
  {% render 'product-card', product: product, placeholder: 'product-2', show_price: false %}
{% enddoc %}

{% liquid
  assign placeholder_name = placeholder | default: 'product-1'
  if show_price == nil
    assign show_price = true
  endif

  assign price_display = product.price | money
  assign compare_display = product.compare_at_price | money
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
%}

<a class="product-card" href="{{ product.url }}">
  <div class="product-card__media">
    {% if product.featured_image %}
      {{
        product.featured_image
        | image_url: width: 1400
        | image_tag:
          class: 'product-card__image',
          widths: '300, 500, 700, 900, 1200, 1400',
          sizes: '(min-width: 900px) 32vw, (min-width: 600px) 46vw, 92vw',
          loading: 'lazy'
      }}
    {% else %}
      {{ placeholder_name | placeholder_svg_tag: 'media-placeholder product-card__placeholder' }}
    {% endif %}

    {% unless product.available %}
      <span class="badge product-card__badge">{{ 'products.sold_out' | t }}</span>
    {% endunless %}
  </div>

  <div class="product-card__info">
    <h3 class="product-card__title">{{ product.title | escape }}</h3>

    {% if show_price %}
      <p class="product-card__price{% if on_sale %} product-card__price--sale{% endif %}">
        {% if on_sale %}
          <span class="visually-hidden">{{ 'products.sale_price' | t }}</span>
          {{ price_display }}
          <s class="product-card__price-compare">{{ compare_display }}</s>
        {% elsif product.price_varies %}
          {{ 'products.price_from' | t: price: price_display }}
        {% else %}
          {{ price_display }}
        {% endif %}
      </p>
    {% endif %}
  </div>
</a>

{% stylesheet %}
  .product-card {
    display: grid;
    gap: 1.15rem;
    align-content: start;
    text-decoration: none;
    color: var(--color-foreground);
  }

  /* Frameless: the photograph carries the card, not a bordered tile. */
  .product-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
  }

  .product-card__image,
  .product-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-card__image {
    transition: transform 0.6s var(--ease-out);
  }

  .product-card:hover .product-card__image,
  .product-card:focus-visible .product-card__image {
    transform: scale(1.03);
  }

  .product-card__badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
  }

  /* Stacked so long product titles never crowd the price. */
  .product-card__info {
    display: grid;
    gap: 0.5rem;
  }

  .product-card__title {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-wrap: balance;
    transition: color var(--duration) var(--ease-out);
  }

  .product-card:hover .product-card__title,
  .product-card:focus-visible .product-card__title {
    color: var(--color-accent);
  }

  .product-card__price {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }

  /* A real Shopify sale state, so it earns the accent. */
  .product-card__price--sale {
    color: var(--color-accent-strong);
    font-weight: 700;
  }

  .product-card__price-compare {
    margin-left: 0.45rem;
    color: var(--color-foreground-muted);
    font-weight: 400;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card__image,
    .product-card__title {
      transition: none;
    }

    .product-card:hover .product-card__image {
      transform: none;
    }
  }
{% endstylesheet %}
